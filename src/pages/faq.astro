---
import Layout from "../layouts/Layout.astro";

interface FAQItem {
  number: number;
  slug: string;
  question: string;
  answer: string;
}

const faqs: FAQItem[] = [
  {
    number: 1,
    slug: "what-is-the-idea-behind-lupyd",
    question: "What is the idea behind Lupyd?",
    answer: "Lupyd was created around one core idea: privacy and encryption — something most platforms today don't take seriously enough. \"Encryption\" simply means turning your data into a secret code that only you and the people you're talking to can read, so no one else — not hackers, not companies, not even Lupyd itself — can see it. The goal is to give people a space online where their information actually stays theirs."
  },
  {
    number: 2,
    slug: "what-is-lupyd",
    question: "What is Lupyd?",
    answer: "Lupyd is a private, collaborative platform — meaning it's an online space where people can work together, chat, and share things, but without exposing their personal information to outsiders. Think of it as a safe, closed room for your conversations and teamwork, instead of an open hall where anyone could be listening in."
  },
  {
    number: 3,
    slug: "why-should-we-use-lupyd",
    question: "Why should we use Lupyd?",
    answer: "Lupyd gives you a private environment that's free from data leaks. A \"data leak\" happens when personal or company information accidentally (or through hacking) becomes public — something that happens far too often with other platforms. Lupyd is built specifically to prevent that, while still making it easy for teams and individuals to collaborate smoothly."
  },
  {
    number: 4,
    slug: "how-can-i-benefit-from-lupyd",
    question: "How can I benefit from Lupyd?",
    answer: "Simply put, Lupyd is designed to protect you and your data. Whether you're chatting with friends, working with a team, or sharing files, Lupyd works quietly in the background to keep your information safe from prying eyes, hackers, and data collectors."
  },
  {
    number: 5,
    slug: "why-is-lupyd-an-alternative-to-other-apps",
    question: "Why is Lupyd an alternative to other apps and websites?",
    answer: "Lupyd offers a more organized and professional platform for collaboration. Instead of juggling multiple apps for chatting, sharing files, and working together, Lupyd brings it all into one clean, structured space — making it easier and more efficient than switching between several less-secure tools."
  },
  {
    number: 6,
    slug: "why-should-i-use-lupyd-instead-of-other-apps",
    question: "Why should I use Lupyd instead of other apps?",
    answer: "Because Lupyd focuses on giving you the best visual chat experience — meaning conversations aren't just text on a screen, but a smooth, engaging, and easy-to-use interface that makes communication feel more natural and enjoyable, all while keeping your data private."
  },
  {
    number: 7,
    slug: "is-lupyd-for-big-organizations-or-everybody",
    question: "Is Lupyd for big organizations or for everybody?",
    answer: "Lupyd is for everybody. Whether you're a student, a freelancer, a small business owner, or part of a large company, Lupyd is built to work for anyone who values privacy and wants a better place to collaborate."
  },
  {
    number: 8,
    slug: "where-can-lupyd-be-used",
    question: "Where can Lupyd be used?",
    answer: "Lupyd fits into almost any part of daily life — schools (for students and teachers to communicate and collaborate), gaming (for private, secure chats between players), reviews (sharing honest feedback without exposure), offices (secure teamwork and file sharing), and more. It's flexible enough to be useful wherever people need to connect and share information safely."
  },
  {
    number: 9,
    slug: "how-is-lupyd-useful-for-students",
    question: "How is Lupyd useful for students?",
    answer: "Students can experience something close to a real office environment — meaning Lupyd helps them practice real-world collaboration, communication, and organization skills, similar to what they'd encounter working in a professional job, all while keeping their academic discussions and projects private and secure."
  },
  {
    number: 10,
    slug: "is-lupyd-a-saas",
    question: "Is Lupyd a SaaS (Software as a Service)?",
    answer: "Yes, Lupyd is a SaaS platform. \"SaaS\" stands for Software as a Service — it means you don't need to download or install complicated software on your computer. Instead, you access Lupyd through the internet (usually with a subscription), and updates, security, and maintenance are all handled for you automatically."
  },
  {
    number: 11,
    slug: "can-lupyd-compete-in-the-market",
    question: "Can Lupyd compete in the market against other players?",
    answer: "Yes, Lupyd has what it takes to compete with other platforms in the market. While there are many collaboration and communication tools out there, Lupyd's strong focus on privacy and encryption gives it a unique edge that many competitors don't offer."
  },
  {
    number: 12,
    slug: "can-lupyd-be-trusted-by-companies",
    question: "Can Lupyd be trusted by companies?",
    answer: "Yes — in fact, Lupyd is specifically designed with companies and organizations in mind. Businesses handle a lot of sensitive information, and Lupyd's privacy-first approach makes it a reliable choice for protecting company data, internal communications, and collaborative projects."
  },
  {
    number: 13,
    slug: "how-can-i-trust-end-to-end-encryption",
    question: "How can I trust that it is end-to-end encrypted?",
    answer: "\"End-to-end encryption\" means that only the sender and the receiver of a message can read it — not even Lupyd's own servers can access the content in between. To prove this isn't just a claim, Lupyd makes its code open source (explained more below), so anyone — including independent experts — can inspect exactly how the encryption works and confirm it's genuine."
  },
  {
    number: 14,
    slug: "what-happens-if-lupyd-gets-hacked",
    question: "What happens if Lupyd gets hacked?",
    answer: "While no system can promise it will never face an attempted attack, Lupyd is built with strong security measures specifically to shield user data from being exposed, even if someone tries to break in. Protecting your information isn't an afterthought — it's the foundation Lupyd is built on."
  },
  {
    number: 15,
    slug: "is-lupyd-open-source",
    question: "Is Lupyd open source?",
    answer: "Lupyd is partially open source. While the entire Lupyd platform isn't fully open to the public, its encryption engine, Firefly, is open source. This gives users a way to independently verify that the privacy and security promises Lupyd makes are real, even though the rest of the platform remains proprietary."
  },
  {
    number: 16,
    slug: "which-languages-are-involved-in-building-lupyd",
    question: "Which languages are involved in building Lupyd?",
    answer: "Lupyd is built using modern, reliable programming languages including Rust (known for speed and strong security), React.js (used for building smooth, interactive user interfaces), TypeScript (which helps make code more reliable and easier to maintain), and other supporting technologies."
  },
  {
    number: 17,
    slug: "is-a-lupyd-subscription-beneficial-for-normal-user",
    question: "Is a Lupyd subscription beneficial for a normal user?",
    answer: "Yes. While Lupyd offers powerful features that are great for organizations, everyday individual users also benefit from special features included in the subscription — such as enhanced privacy tools and a better overall experience — making it worthwhile even if you're not part of a big company."
  },
  {
    number: 18,
    slug: "what-changes-is-lupyd-going-to-bring",
    question: "What changes is Lupyd going to bring to the internet/platform space?",
    answer: "Lupyd aims to raise the privacy standards of the digital world. In simple terms, the goal is to push other platforms to take user privacy more seriously by showing that a secure, encrypted, and trustworthy platform can still be easy to use and enjoyable — setting a new benchmark for what people should expect online."
  },
  {
    number: 19,
    slug: "is-lupyd-hiring",
    question: "Is Lupyd hiring?",
    answer: "Yes, Lupyd is currently hiring for a variety of roles across different departments. If you're interested in being part of a privacy-focused platform from an early stage, it could be a great opportunity to explore."
  },
  {
    number: 20,
    slug: "is-there-career-guidance-at-lupyd",
    question: "Is there any career guidance available at Lupyd?",
    answer: "Not at the moment, but it's something planned for the near future. Lupyd intends to offer guidance and support for those interested in building a career within the company or in the privacy-tech space more broadly."
  }
];

// Schema.org FAQPage structured data for Google SEO rich snippets and direct question links
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "url": `https://about.lupyd.com/faq#${faq.slug}`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
  title="FAQ - Lupyd"
  description="Frequently Asked Questions about Lupyd: privacy, encryption, open source, and collaboration."
>

  <!-- Google FAQPage Structured Data for SEO Direct Jump Links -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="faq-page-wrapper">
    <!-- Grid Background (Neutral / Monochromatic, No Pink) -->
    <div class="faq-bg-grid" aria-hidden="true"></div>

    <div class="faq-container">
      
      <!-- ═════════════════════════════════════════════════════════
           SECTION 1: HERO
      ═════════════════════════════════════════════════════════ -->
      <section class="faq-header-section sr" id="top" aria-label="FAQ Introduction">
        <span class="faq-pill">FAQ</span>
        <h1 class="faq-title">
          Frequently Asked<br/>
          <em>Questions</em>
        </h1>
        <p class="faq-subtitle">
          Curious about Lupyd? Here's everything you need to know.
        </p>

        <!-- Floating 3D decorative clay element -->
        <div class="faq-hero-float-badge" aria-hidden="true">
          <div class="clay-badge-dots">
            <span class="clay-dot"></span>
            <span class="clay-dot"></span>
            <span class="clay-dot"></span>
          </div>
          <div class="clay-badge-shield">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
        </div>
      </section>

      <!-- Watermark brand text matching reference design -->
      <div class="faq-watermark" aria-hidden="true">@LUPYD.COM</div>

      <!-- ═════════════════════════════════════════════════════════
           SECTION 2: FAQ SPEECH BUBBLES (Direct-Linkable Sections)
      ═════════════════════════════════════════════════════════ -->
      <section class="faq-bubbles-section" id="faq-list" aria-label="Frequently Asked Questions">
        <div class="faq-bubbles-grid">
          {faqs.map((faq, index) => {
            const isDark = (Math.floor(index / 2) + (index % 2)) % 2 === 0;
            const bubbleTheme = isDark ? "dark" : "light";
            
            return (
              <section
                class={`faq-bubble-card sr faq-bubble-${bubbleTheme}`}
                id={faq.slug}
                aria-labelledby={`q-heading-${faq.number}`}
                style={`animation-delay:${0.03 * index}s`}
              >
                <!-- Direct Anchor Jump Link Button for Users & SEO Sharing -->
                <a
                  href={`#${faq.slug}`}
                  class="faq-anchor-link"
                  title="Direct link to this question"
                  aria-label={`Direct link to question: ${faq.question}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                  </svg>
                  <span class="faq-anchor-toast">Copied link!</span>
                </a>

                <div class="faq-bubble-inner">
                  <!-- Question Row -->
                  <div class="faq-bubble-row faq-row-question">
                    <span class="faq-bubble-badge" aria-hidden="true">Q</span>
                    <div class="faq-bubble-text-wrap">
                      <h2 class="faq-bubble-question" id={`q-heading-${faq.number}`}>
                        {faq.question}
                      </h2>
                    </div>
                  </div>

                  <!-- Answer Row -->
                  <div class="faq-bubble-row faq-row-answer">
                    <span class="faq-bubble-badge" aria-hidden="true">A</span>
                    <div class="faq-bubble-text-wrap">
                      <p class="faq-bubble-answer">
                        {faq.answer}
                      </p>
                    </div>
                  </div>
                </div>

                <!-- Speech Bubble Tail -->
                <svg class="faq-bubble-tail" viewBox="0 0 32 20" aria-hidden="true">
                  <path d="M0 0 C6 0 14 12 18 20 C18 10 16 0 32 0 Z" />
                </svg>
              </section>
            );
          })}
        </div>
      </section>

      <!-- ═════════════════════════════════════════════════════════
           SECTION 3: BOTTOM ACTIONS & NAVIGATION
      ═════════════════════════════════════════════════════════ -->
      <section class="faq-bottom-section sr" aria-label="FAQ Navigation">
        <div class="faq-bottom-bubble" aria-hidden="true">
          <div class="clay-badge-dots-bottom">
            <span class="clay-dot"></span>
            <span class="clay-dot"></span>
            <span class="clay-dot"></span>
          </div>
        </div>
        <div class="faq-bottom-links">
          <a href="#top" class="faq-scroll-top-btn" title="Back to top">
            &uarr; Back to Top
          </a>
          <a href="/" class="faq-back-btn">
            &larr; Back to Home
          </a>
        </div>
      </section>

    </div>
  </div>

</Layout>

<style>
/* ─── PAGE WRAPPER & GRID BACKGROUND ─────────────────────────── */
.faq-page-wrapper {
  position: relative;
  padding: 4.5rem 0 6rem;
  background-color: hsl(var(--background));
}

/* Neutral Grid Background (No Pink) */
.faq-bg-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background-image:
    linear-gradient(hsl(var(--border) / 0.6) 1.5px, transparent 1.5px),
    linear-gradient(90deg, hsl(var(--border) / 0.6) 1.5px, transparent 1.5px);
  background-size: 52px 52px;
  mask-image: radial-gradient(ellipse 95% 85% at 50% 10%, black 50%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 95% 85% at 50% 10%, black 50%, transparent 100%);
}

.faq-container {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* Vertical watermark along grid line, matching reference image */
.faq-watermark {
  position: absolute;
  top: 180px;
  left: -20px;
  transform: rotate(-90deg);
  transform-origin: top left;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.28em;
  color: hsl(var(--muted-foreground) / 0.4);
  pointer-events: none;
  user-select: none;
}

@media (max-width: 1200px) {
  .faq-watermark {
    display: none;
  }
}

/* ─── SECTION 1: HERO ────────────────────────────────────────── */
.faq-header-section {
  position: relative;
  max-width: 700px;
  margin: 0 auto 3.75rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.faq-pill {
  display: inline-flex;
  align-items: center;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--card) / 0.8);
  border-radius: 999px;
  padding: 3px 14px;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: hsl(var(--muted-foreground));
  margin-bottom: 1.25rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.faq-title {
  font-size: clamp(2.8rem, 6vw, 4.5rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 0.98;
  color: hsl(var(--foreground));
  margin: 0 0 1.25rem;
}

.faq-title em {
  font-style: italic;
  font-family: serif;
  font-weight: 400;
  color: hsl(var(--muted-foreground));
}

.faq-subtitle {
  font-size: clamp(0.88rem, 1.6vw, 1.05rem);
  color: hsl(var(--muted-foreground));
  line-height: 1.65;
  margin: 0;
  max-width: 520px;
}

/* ─── 3D CLAY FLOATING BADGES ────────────────────────────────── */
.faq-hero-float-badge {
  position: absolute;
  top: 10px;
  right: -50px;
  display: flex;
  align-items: flex-end;
  gap: 6px;
}

@media (max-width: 860px) {
  .faq-hero-float-badge {
    display: none;
  }
}

.clay-badge-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  width: 58px;
  height: 44px;
  border-radius: 16px;
  background: linear-gradient(145deg, #dedcd4, #cac6bc);
  box-shadow:
    0 10px 20px -4px rgba(0, 0, 0, 0.18),
    inset 0 2px 3px rgba(255, 255, 255, 0.7),
    inset 0 -3px 4px rgba(0, 0, 0, 0.15);
}

.dark .clay-badge-dots {
  background: linear-gradient(145deg, #383535, #262424);
  box-shadow:
    0 10px 20px -4px rgba(0, 0, 0, 0.5),
    inset 0 2px 3px rgba(255, 255, 255, 0.18),
    inset 0 -3px 4px rgba(0, 0, 0, 0.35);
}

.clay-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}

.dark .clay-dot {
  background: #888888;
}

.clay-badge-shield {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #2b2828, #181717);
  color: #ffffff;
  box-shadow:
    0 8px 18px -3px rgba(0, 0, 0, 0.35),
    inset 0 2px 3px rgba(255, 255, 255, 0.25),
    inset 0 -2px 3px rgba(0, 0, 0, 0.4);
}

/* ─── SECTION 2: 3D CLAY CHAT BUBBLES GRID ───────────────────── */
.faq-bubbles-section {
  width: 100%;
}

.faq-bubbles-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2.5rem 2rem;
  align-items: start;
}

@media (max-width: 780px) {
  .faq-bubbles-grid {
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }
}

/* Base Bubble Style as Semantic Section */
.faq-bubble-card {
  position: relative;
  border-radius: 30px;
  padding: 2.2rem 2.2rem 2.4rem;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s ease, border-color 0.3s;
  user-select: text;
  /* Scroll Margin: Ensures header does not cover targeted question */
  scroll-margin-top: 110px;
}

.faq-bubble-card:hover {
  transform: translateY(-4px);
}

/* ── Direct Anchor Highlight Effect (:target for SEO direct jump) ── */
.faq-bubble-card:target {
  animation: targetPulse 1.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  outline: 2px solid hsl(var(--foreground));
  outline-offset: 4px;
}

@keyframes targetPulse {
  0% {
    transform: scale(1.02);
    box-shadow: 0 0 0 6px hsl(var(--foreground) / 0.3), 0 28px 56px -12px rgba(0, 0, 0, 0.6);
  }
  60% {
    transform: scale(1.01);
    box-shadow: 0 0 0 3px hsl(var(--foreground) / 0.2), 0 24px 48px -10px rgba(0, 0, 0, 0.5);
  }
  100% {
    transform: scale(1);
  }
}

/* Bubble Tail */
.faq-bubble-tail {
  position: absolute;
  bottom: -15px;
  left: 48px;
  width: 28px;
  height: 18px;
  pointer-events: none;
}

/* Anchor Link Copy Button */
.faq-anchor-link {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.35;
  transition: opacity 0.15s, background-color 0.15s, color 0.15s;
  text-decoration: none;
  color: inherit;
}

.faq-bubble-card:hover .faq-anchor-link,
.faq-anchor-link:focus {
  opacity: 1;
}

.faq-anchor-link:hover {
  background: rgba(128, 128, 128, 0.2);
}

.faq-anchor-toast {
  position: absolute;
  top: -24px;
  right: 0;
  font-size: 0.65rem;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  background: hsl(var(--foreground));
  color: hsl(var(--background));
  pointer-events: none;
  opacity: 0;
  transform: translateY(4px);
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
}

.faq-anchor-toast.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* ── DARK CLAY BUBBLE ── */
.faq-bubble-dark {
  background: linear-gradient(145deg, #322f2f, #232121);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 22px 42px -10px rgba(0, 0, 0, 0.4),
    0 8px 18px -4px rgba(0, 0, 0, 0.25),
    inset 0 2px 3px rgba(255, 255, 255, 0.16),
    inset 0 -4px 6px rgba(0, 0, 0, 0.35);
}

.faq-bubble-dark:hover {
  box-shadow:
    0 28px 52px -10px rgba(0, 0, 0, 0.5),
    0 12px 24px -4px rgba(0, 0, 0, 0.3),
    inset 0 2px 3px rgba(255, 255, 255, 0.2),
    inset 0 -4px 6px rgba(0, 0, 0, 0.4);
}

.faq-bubble-dark .faq-bubble-tail path {
  fill: #242222;
}

.faq-bubble-dark .faq-bubble-badge {
  color: #ffffff;
}

.faq-bubble-dark .faq-bubble-question {
  color: #ffffff;
}

.faq-bubble-dark .faq-bubble-answer {
  color: rgba(255, 255, 255, 0.88);
}

/* ── LIGHT CLAY BUBBLE ── */
.faq-bubble-light {
  background: linear-gradient(145deg, #f7f5ed, #e6e3d7);
  color: #1e1d1d;
  border: 1px solid rgba(0, 0, 0, 0.05);
  box-shadow:
    0 20px 40px -10px rgba(0, 0, 0, 0.12),
    0 8px 18px -4px rgba(0, 0, 0, 0.06),
    inset 0 2px 4px rgba(255, 255, 255, 0.9),
    inset 0 -4px 6px rgba(0, 0, 0, 0.08);
}

.dark .faq-bubble-light {
  background: linear-gradient(145deg, #e4e1d7, #cfcbc0);
  box-shadow:
    0 20px 42px -10px rgba(0, 0, 0, 0.4),
    0 8px 18px -4px rgba(0, 0, 0, 0.25),
    inset 0 2px 4px rgba(255, 255, 255, 0.85),
    inset 0 -4px 6px rgba(0, 0, 0, 0.12);
}

.faq-bubble-light:hover {
  box-shadow:
    0 26px 48px -10px rgba(0, 0, 0, 0.16),
    0 12px 24px -4px rgba(0, 0, 0, 0.08),
    inset 0 2px 4px rgba(255, 255, 255, 0.95),
    inset 0 -4px 6px rgba(0, 0, 0, 0.1);
}

.faq-bubble-light .faq-bubble-tail path {
  fill: #e6e3d7;
}

.dark .faq-bubble-light .faq-bubble-tail path {
  fill: #cfcbc0;
}

.faq-bubble-light .faq-bubble-badge {
  color: #1a1a1c;
}

