<script>
  function initDirectJump() {
    const anchorLinks = document.querySelectorAll<HTMLAnchorElement>('.faq-anchor-link');

    // Function to scroll directly to question target
    function jumpToElement(targetId: string) {
      const el = document.getElementById(targetId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Direct Anchor Link Copy to Clipboard
    anchorLinks.forEach(link => {
      link.addEventListener('click', async (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const targetId = href.slice(1);
          const fullUrl = new URL(window.location.href);
          fullUrl.hash = targetId;

          try {
            await navigator.clipboard.writeText(fullUrl.href);
            const toast = link.querySelector('.faq-anchor-toast');
            if (toast) {
              toast.classList.add('is-visible');
              setTimeout(() => {
                toast.classList.remove('is-visible');
              }, 1800);
            }
          } catch {
            // fallback
          }
        }
      });
    });

    // Check if page loaded with a URL hash (e.g. from Google search or external direct link)
    if (window.location.hash) {
      const hashId = window.location.hash.slice(1);
      setTimeout(() => {
        jumpToElement(hashId);
      }, 100);
    }
  }

  function initSR() {
    const els = document.querySelectorAll('.sr');
    if (!('IntersectionObserver' in window)) {
      els.forEach(el => el.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
    els.forEach(el => io.observe(el));
  }

  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', () => { initDirectJump(); initSR(); })
    : (() => { initDirectJump(); initSR(); })();

  document.addEventListener('astro:page-load', () => { initDirectJump(); initSR(); });
</script>
