---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const siteBase = (Astro.site ? new URL(Astro.site).origin : "https://www.lupyd.com").replace(/\/$/, "");

const getDesktopFeatureSrcset = (src: string) => {
  const base = src.replace(/\.webp$/, '');
  return `${base}-640.webp 640w, ${base}-1024.webp 1024w, ${src} 1440w`;
};

const features = [
  {
    number: "01",
    tag: "Encryption",
    title: "Signal Protocol & MLS Encryption",
    description: "Conversations are end-to-end encrypted using the Signal Protocol for direct messages and Messaging Layer Security (MLS) for group chats. Shared files, attachments, and chat backups are protected with AES encryption. Keys remain on your devices.",
    details: [
      "Signal Protocol for 1-on-1 conversations",
      "Messaging Layer Security (MLS) for group chats",
      "AES encryption for files and backups",
      "Multi-device cryptographic key management"
    ],
    screenshot: "/screenshots/desktop/dm-dark.webp",
    screenshotAlt: "Lupyd Direct Messaging Interface"
  },
  {
    number: "02",
    tag: "Channels",
    title: "Custom Channel Creation & Organization",
    description: "Create text, voice, or announcement channels on the fly. Organize conversations with targeted topics, channel-specific privacy settings, and dedicated access rules.",
    details: [
      "Text, Voice, and Announcement channel types",
      "Public and private channel visibility controls",
      "Channel-specific permission overrides",
      "Real-time synchronization across devices"
    ],
    screenshot: "/screenshots/desktop/channel-create-dark.webp",
    screenshotAlt: "Lupyd Channel Creation Interface"
  },
  {
    number: "03",
    tag: "Permissions",
    title: "Arbitrary Roles & Granular Permissions",
    description: "No fixed hierarchies like admin or moderator. Build any custom role from the ground up, define its exact permission flags, and assign it to any member. Anything can be anyone.",
    details: [
      "No locked role hierarchies—create any role name",
      "Fine-grained workspace and channel permission flags",
      "Custom role colors, order, and member assignment",
      "Invite members and allocate access dynamically"
    ],
    screenshot: "/screenshots/desktop/roles-dark.webp",
    screenshotAlt: "Lupyd Roles and Permissions Management Interface"
  },
  {
    number: "04",
    tag: "Search",
    title: "Local Full-Text Search",
    description: "Search across message history instantly. Lupyd maintains an inverted index locally on your device, returning results in milliseconds without sending your search queries to a remote server.",
    details: [
      "Local on-device indexing",
      "Fast keyboard search shortcut",
      "Filter by channel, sender, and date",
      "Instant query results with zero server leakage"
    ],
    screenshot: "/screenshots/desktop/messages-dark.webp",
    screenshotAlt: "Lupyd Search and Messaging Interface"
  },
  {
    number: "05",
    tag: "Security",
    title: "Client Security & Multi-Device Sync",
    description: "Seamlessly switch between macOS, Windows, Linux, and Android with cryptographic session sync. Manage active sessions and encryption keys without central telemetry.",
    details: [
      "Multi-device sync across macOS, Windows, Linux, and Android",
      "Zero tracking scripts, telemetry beacons, or third-party ads",
      "On-device encryption key management",
      "Complete data sovereignty and session revocation"
    ],
    screenshot: "/screenshots/desktop/settings-dark.webp",
    screenshotAlt: "Lupyd Settings and Security Interface"
  },
  {
    number: "06",
    tag: "Audio & Video",
    title: "Voice & Video Calls",
    description: "Encrypted voice and video calling built directly into your channels and direct conversations. Connect with your team without leaving the app.",
    details: [
      "Direct encrypted audio and video",
      "Screen sharing support",
      "Low latency connection",
      "Works across supported desktop and mobile devices"
    ],
    screenshot: "/screenshots/desktop/calls-dark.webp",
    screenshotAlt: "Lupyd Voice and Video Calling Interface"
  },
  {
    number: "07",
    tag: "Media",
    title: "AES Encrypted File Sharing & Backups",
    description: "Send documents, images, and project files with AES encryption. Files are encrypted before upload and decrypted on the receiving device. Export and restore encrypted chat backups.",
    details: [
      "Client-side AES file encryption",
      "Inline image and document previews",
      "Encrypted chat backup exports and restores",
      "Drag-and-drop file transfers"
    ],
    screenshot: "/screenshots/desktop/media-dark.webp",
    screenshotAlt: "Lupyd Media and File Library Interface"
  }
];

const featuresSchema = {
  "@type": "ItemList",
  "@id": `${siteBase}/features#list`,
  "name": "Lupyd Features",
  "description": "Core features of Lupyd: Signal Protocol and MLS encryption, custom channels and creation, arbitrary roles and permissions, local search, client security, voice/video calls, and AES encrypted files.",
  "itemListElement": features.map((feature, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": feature.title,
    "description": feature.description
  }))
};
---

<Layout
  title="Features - Lupyd"
  description="Explore Lupyd features: Signal Protocol and MLS encryption, custom channels, flexible roles and permissions, local full-text search, AES file encryption, and multi-device sync."
  breadcrumbs={[{ name: "Features", href: "/features" }]}
  schema={featuresSchema}
>
  <div class="features-page relative w-full flex-1">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16 w-full">
      <div class="pb-6">
        <Breadcrumbs items={[{ name: "Features" }]} />
      </div>

      <!-- Header -->
      <div class="max-w-3xl mb-16 md:mb-20">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-foreground">
          Features
        </h1>
        <p class="mt-4 text-base sm:text-lg text-muted-foreground leading-relaxed">
          Lupyd uses the Signal Protocol and MLS for conversation encryption, AES for files and backups, and gives you complete control over channels and custom roles.
        </p>
      </div>

      <!-- Features List -->
      <div class="space-y-16 md:space-y-24">
        {features.map((item, index) => {
          const isReversed = index % 2 === 1;
          return (
            <section class="feature-item pb-16 border-b border-border/50 last:border-0 last:pb-0" id={`feature-${item.number}`}>
              <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center ${isReversed ? 'lg:flex-row-reverse' : ''}`}>
                
                <!-- Text Column -->
                <div class={`lg:col-span-5 space-y-4 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs text-muted-foreground">{item.number}</span>
                    <span class="text-muted-foreground/40">/</span>
                    <span class="text-xs uppercase tracking-wider font-semibold text-muted-foreground">{item.tag}</span>
                  </div>

                  <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">
                    {item.title}
                  </h2>

                  <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
                    {item.description}
                  </p>

                  <ul class="space-y-2 pt-2">
                    {item.details.map((detail) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-foreground/80">
                        <span class="w-1.5 h-1.5 rounded-full bg-foreground/40 mt-1.5 shrink-0" aria-hidden="true"></span>
                        <span>{detail}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Window Screenshot Column -->
                <div class={`lg:col-span-7 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                  <div class="rounded-xl border border-border bg-card overflow-hidden shadow-sm">
                    <!-- Clean Monotonic Window Chrome -->
                    <div class="flex items-center justify-between px-3.5 py-2 border-b border-border bg-muted/30 select-none">
                      <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-border inline-block"></span>
                        <span class="w-2 h-2 rounded-full bg-border inline-block"></span>
                        <span class="w-2 h-2 rounded-full bg-border inline-block"></span>
                      </div>
                      <div class="text-xs font-medium text-muted-foreground tracking-tight">
                        Lupyd
                      </div>
                      <div class="w-8"></div>
                    </div>

                    <!-- Screenshot Container - No hover zoom, preserves image borders -->
                    <div class="relative bg-background aspect-[16/10] overflow-hidden">
                      <!-- Dark mode screenshot -->
                      <img
                        src={item.screenshot}
                        srcset={getDesktopFeatureSrcset(item.screenshot)}
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 800px"
                        alt={item.screenshotAlt}
                        loading="lazy"
                        width="1440"
                        height="900"
                        class="hidden dark:block w-full h-full object-cover object-top"
                      />
                      <!-- Light mode screenshot -->
                      <img
                        src={item.screenshot.replace('-dark.webp', '.webp')}
                        srcset={getDesktopFeatureSrcset(item.screenshot.replace('-dark.webp', '.webp'))}
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 800px"
                        alt={item.screenshotAlt}
                        loading="lazy"
                        width="1440"
                        height="900"
                        class="block dark:hidden w-full h-full object-cover object-top"
                      />
                    </div>
                  </div>
                </div>

              </div>
            </section>
          );
        })}
      </div>

      <!-- Bottom Simple Navigation -->
      <div class="mt-20 pt-10 border-t border-border/60 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h3 class="font-bold text-foreground">Ready to try Lupyd?</h3>
          <p class="text-sm text-muted-foreground">Available on macOS, Windows, Linux, and Android.</p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href="https://lupyd.com"
            class="inline-flex items-center justify-center rounded-md font-semibold bg-primary text-primary-foreground hover:opacity-90 transition-all h-10 px-5 text-sm"
          >
            Get Started
          </a>
          <a
            href="https://download.lupyd.com"
            class="inline-flex items-center justify-center rounded-md font-semibold border border-border bg-background hover:bg-muted transition-colors h-10 px-5 text-sm"
          >
            Downloads
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
