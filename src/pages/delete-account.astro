---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const siteBase = (Astro.site ? new URL(Astro.site).origin : "https://www.lupyd.com").replace(/\/$/, "");

const deleteDocSchema = {
  "@type": "WebPage",
  "@id": `${siteBase}/delete-account#webpage`,
  "name": "Delete Account & Data - Lupyd",
  "headline": "Delete Account & Data - Lupyd",
  "description": "How to request deletion of your Lupyd account and associated data.",
  "url": `${siteBase}/delete-account`,
  "publisher": {
    "@type": "Organization",
    "name": "Lupyd Media Private Limited",
    "url": siteBase
  }
};
---

<Layout
  title="Delete Account & Data - Lupyd"
  description="Request deletion of your Lupyd account and data. Send a request to contact@lupyd.com from your registered email."
  pageType="WebPage"
  breadcrumbs={[
    { name: "Legal", href: "/privacy" },
    { name: "Delete Account", href: "/delete-account" }
  ]}
  schema={deleteDocSchema}
>
  <!-- Legal Sub-nav Tabs -->
  <section class="border-b border-border/50 bg-background/60 backdrop-blur-md sticky top-16 z-30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2 sm:gap-6 overflow-x-auto no-scrollbar py-1">
        <a
          href="/privacy"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-of-use"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Terms of Use
        </a>
        <a
          href="/terms-of-service"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Terms of Service
        </a>
        <a
          href="/delete-account"
          class="text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-full bg-foreground text-background transition-colors whitespace-nowrap"
          aria-current="page"
        >
          Delete Account
        </a>
      </div>
    </div>
  </section>

  <!-- Main Container -->
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <div class="mb-6">
      <Breadcrumbs items={[{ name: "Legal", href: "/privacy" }, { name: "Delete Account" }]} />
    </div>

    <div class="space-y-8">
      <!-- Title & Developer Reference -->
      <div>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-foreground">
          Delete Account &amp; Data
        </h1>
        <p class="text-sm text-muted-foreground mt-2">
          App: <strong>Lupyd</strong> &bull; Developer: <strong>Lupyd Media Private Limited</strong>
        </p>
      </div>

      <!-- Main Action Callout -->
      <div class="p-6 sm:p-8 rounded-2xl border border-border/80 bg-card/60 shadow-sm space-y-4">
        <h2 class="text-xl font-bold text-foreground">
          How to request account deletion
        </h2>
        <p class="text-foreground/90 text-base leading-relaxed">
          You can request to delete your Lupyd account and associated data at any time by sending an email to:
        </p>
        <div class="p-4 rounded-xl bg-muted/80 border border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <a
            href="mailto:contact@lupyd.com?subject=Request%20to%20delete%20Lupyd%20account"
            class="text-lg font-bold text-primary hover:underline font-mono break-all"
          >
            contact@lupyd.com
          </a>
          <a
            href="mailto:contact@lupyd.com?subject=Request%20to%20delete%20Lupyd%20account"
            class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-primary text-primary-foreground font-semibold text-sm hover:opacity-90 transition-opacity shrink-0"
          >
            Send Email
          </a>
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Please make sure to send the request from the <strong>email address you used to sign up or log in to Lupyd</strong> so we can verify account ownership.
        </p>
        <div class="pt-2 text-sm font-semibold text-foreground">
          Your request will be processed and completed within <span class="text-primary font-bold">24&ndash;72 hours</span>.
        </div>
      </div>

      <!-- Data Details -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
        <div class="p-5 rounded-xl border border-border/60 bg-card/30 space-y-3">
          <h3 class="text-base font-bold text-foreground">Data that is deleted</h3>
          <ul class="text-sm text-muted-foreground space-y-1.5 list-disc list-inside">
            <li>Your account profile (username, email, avatar, bio)</li>
            <li>All messages, chats, and conversation history</li>
            <li>Uploaded files, media, and attachments</li>
            <li>Encryption keys and active login sessions</li>
          </ul>
        </div>

        <div class="p-5 rounded-xl border border-border/60 bg-card/30 space-y-3">
          <h3 class="text-base font-bold text-foreground">Data kept &amp; retention period</h3>
          <ul class="text-sm text-muted-foreground space-y-1.5 list-disc list-inside">
            <li>Financial or transaction records required by law for taxation and accounting (retained up to 180 days)</li>
            <li>Encrypted system backups are automatically overwritten and purged within 30 days</li>
          </ul>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="pt-4 border-t border-border/50 text-xs text-muted-foreground space-y-1">
        <p>Lupyd Media Private Limited &bull; 15-18-276/5/A/1, Prashanti Nagar 2, Khammam, Telangana 507002, India</p>
        <p>Questions? Reach us anytime at <a href="mailto:contact@lupyd.com" class="text-foreground hover:underline">contact@lupyd.com</a>.</p>
      </div>
    </div>
  </main>
</Layout>
