  <script>
    const copyBtn = document.getElementById('copy-template-btn');
    const copyText = document.getElementById('copy-text');
    const templateContent = document.getElementById('email-template-content');

    if (copyBtn && copyText && templateContent) {
      copyBtn.addEventListener('click', async () => {
        try {
          const textToCopy = templateContent.innerText;
          await navigator.clipboard.writeText(textToCopy);
          const originalText = copyText.textContent;
          copyText.textContent = 'Copied to clipboard!';
          copyBtn.classList.add('bg-emerald-500/20', 'text-emerald-500', 'border-emerald-500/40');
          setTimeout(() => {
            copyText.textContent = originalText;
            copyBtn.classList.remove('bg-emerald-500/20', 'text-emerald-500', 'border-emerald-500/40');
          }, 2500);
        } catch (err) {
          // Fallback if clipboard API is blocked
          copyText.textContent = 'Selected - press Ctrl+C';
        }
      });
    }
  </script>
