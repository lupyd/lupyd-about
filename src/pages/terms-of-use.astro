---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const sections = [
  { id: "introduction", title: "Introduction" },
  { id: "user-accounts", title: "User Accounts" },
  { id: "acceptable-use", title: "Acceptable Use Policy" },
  { id: "csam-policy", title: "Child Safety & CSAM Policy" },
  { id: "intellectual-property", title: "Intellectual Property Rights" },
  { id: "user-content", title: "User-Generated Content" },
  { id: "limitation-liability", title: "Limitation of Liability" },
  { id: "indemnification", title: "Indemnification" },
  { id: "termination", title: "Termination" },
  { id: "dispute-resolution", title: "Dispute Resolution" },
  { id: "contact-us", title: "Contact Us" },
];

const siteBase = (Astro.site ? new URL(Astro.site).origin : "https://www.lupyd.com").replace(/\/$/, "");
const termsDocSchema = {
  "@type": "DigitalDocument",
  "@id": `${siteBase}/terms-of-use#document`,
  "name": "Lupyd Terms of Use",
  "headline": "Terms of Use - Lupyd",
  "description": "These Terms of Use govern your access to and use of Lupyd, our website, mobile application, and all related services.",
  "url": `${siteBase}/terms-of-use`,
  "dateModified": "2025-10-01",
  "inLanguage": "en-US",
  "publisher": {
    "@type": "Organization",
    "name": "Lupyd",
    "url": siteBase
  }
};
---

<Layout
  title="Terms of Use - Lupyd"
  description="These Terms of Use govern your access to and use of Lupyd, our website, mobile application, and all related services. By using Lupyd, you agree to be bound by these terms."
  pageType="WebPage"
  modifiedTime="2025-10-01"
  breadcrumbs={[
    { name: "Legal", href: "/terms-of-use" },
    { name: "Terms of Use", href: "/terms-of-use" }
  ]}
  schema={termsDocSchema}
>
  <!-- Legal Sub-nav Tabs -->
  <section class="border-b border-border/50 bg-background/60 backdrop-blur-md sticky top-16 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2 sm:gap-6 overflow-x-auto no-scrollbar py-1">
        <a
          href="/privacy"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-of-use"
          class="text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-full bg-foreground text-background transition-colors whitespace-nowrap"
        >
          Terms of Use
        </a>
        <a
          href="/terms-of-service"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Terms of Service
        </a>
      </div>
      <span class="hidden sm:inline-block text-xs text-muted-foreground font-mono">Last updated: Oct 2025</span>
    </div>
  </section>

  <!-- Page Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <div class="mb-6">
      <Breadcrumbs items={[{ name: "Legal", href: "/terms-of-use" }, { name: "Terms of Use" }]} />
    </div>

    <!-- Header -->
    <div class="mb-10 sm:mb-14">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">Legal Documentation</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground mb-4">Terms of Use</h1>
      <p class="text-lg sm:text-xl text-muted-foreground max-w-3xl leading-relaxed">
        These Terms of Use govern your access to and use of Lupyd, our website, mobile application, and all related services. By using Lupyd, you agree to be bound by these terms.
      </p>
      <p class="text-xs text-muted-foreground mt-3 font-mono sm:hidden">Last updated: October 2025</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
      <!-- Sidebar Table of Contents -->
      <aside class="lg:col-span-1">
        <div class="sticky top-32 space-y-1 p-4 rounded-xl border border-border/50 bg-card/40 backdrop-blur-sm">
          <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3 px-3">Table of Contents</h2>
          <nav id="toc-nav" class="space-y-1">
            {sections.map((section, idx) => (
              <a
                href={`#${section.id}`}
                data-section={section.id}
                class={`toc-link block text-xs sm:text-sm py-2 px-3 rounded-lg transition-all ${
                  idx === 0
                    ? "font-semibold bg-foreground text-background"
                    : "text-muted-foreground hover:text-foreground hover:bg-muted/60"
                }`}
              >
                {section.title}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Document Content -->
      <main class="lg:col-span-3 space-y-12 text-foreground/90 leading-relaxed">
        <!-- Introduction -->
        <section id="introduction" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Introduction</h2>
          <p>
            Welcome to Lupyd (&ldquo;Platform,&rdquo; &ldquo;we,&rdquo; &ldquo;us,&rdquo; &ldquo;our,&rdquo; or &ldquo;Company&rdquo;). These Terms of Use (&ldquo;Terms&rdquo;) constitute a legally binding agreement between you and Lupyd regarding your use of our website, mobile application, and all related services (collectively, the &ldquo;Service&rdquo;).
          </p>
          <p>
            By accessing, browsing, or using Lupyd, you acknowledge that you have read, understood, and agree to be bound by these Terms. If you do not agree with any part of these Terms, you must not use our Service.
          </p>
          <p>
            We reserve the right to modify these Terms at any time. Changes will be effective immediately upon posting to the Service. Your continued use of Lupyd following any modifications constitutes your acceptance of the updated Terms.
          </p>
        </section>

        <!-- User Accounts -->
        <section id="user-accounts" class="scroll-mt-36 space-y-5">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">User Accounts</h2>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Account Creation</h3>
            <p class="text-sm text-muted-foreground">To use certain features of Lupyd, you must create an account. When creating an account, you agree to:</p>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>Provide accurate, current, and complete information</li>
              <li>Maintain the confidentiality of your password</li>
              <li>Accept responsibility for all activities under your account</li>
              <li>Notify us immediately of any unauthorized access</li>
              <li>Be at least 13 years old (18 in some jurisdictions)</li>
            </ul>
          </div>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Account Termination</h3>
            <p class="text-sm sm:text-base text-muted-foreground">
              You may terminate your account at any time by contacting our support team. Upon termination, your access to the Service will be revoked, though we may retain certain information as required by law.
            </p>
          </div>
        </section>

        <!-- Acceptable Use -->
        <section id="acceptable-use" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Acceptable Use Policy</h2>
          <p class="text-muted-foreground">
            You agree not to use Lupyd for any unlawful or prohibited purposes. Specifically, you agree not to:
          </p>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30">
            <ul class="list-disc list-inside space-y-2 text-sm sm:text-base text-muted-foreground">
              <li>Violate any applicable local, state, national, or international law</li>
              <li>Harass, threaten, defame, or abuse other users</li>
              <li>Post or transmit spam, malware, or harmful content</li>
              <li>Attempt to gain unauthorized access to our systems</li>
              <li>Engage in phishing, fraud, or deceptive practices</li>
              <li>Scrape, crawl, or automate access to the Service</li>
              <li>Interfere with or disrupt the Service or its infrastructure</li>
              <li>Engage in any form of discrimination or hate speech</li>
            </ul>
          </div>
        </section>

        <!-- Child Safety & CSAM Policy -->
        <section id="csam-policy" class="scroll-mt-36 space-y-6 pt-6 border-t border-border/60">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-500 dark:text-red-400 text-xs font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Zero-Tolerance Policy
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Child Safety &amp; CSAM Policy</h2>
            <p class="text-muted-foreground">
              Lupyd has a <strong class="text-foreground font-semibold">zero-tolerance policy</strong> for Child Sexual Abuse Material (CSAM) and any content that exploits or endangers children. We are committed to maintaining a safe environment and protecting minors from harm.
            </p>
          </div>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Prohibited Content</h3>
            <p class="text-sm text-muted-foreground">The following activities are strictly prohibited on our platform:</p>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>Uploading, sharing, or distributing any form of CSAM</li>
              <li>Creating, possessing, or transmitting sexually explicit content involving minors</li>
              <li>Grooming, soliciting, or attempting to exploit children</li>
              <li>Sharing content that sexualizes minors in any way</li>
              <li>Facilitating or promoting child exploitation</li>
            </ul>
          </div>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Our Commitment</h3>
            <p class="text-sm text-muted-foreground">We actively monitor our platform and take immediate action when CSAM or child exploitation is detected:</p>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>Immediate removal of all CSAM content</li>
              <li>Permanent account termination for violators</li>
              <li>Reporting to the National Center for Missing &amp; Exploited Children (NCMEC)</li>
              <li>Cooperation with law enforcement agencies worldwide</li>
              <li>Preservation of evidence for legal proceedings</li>
            </ul>
          </div>

          <!-- Alert Reporting Box -->
          <div class="p-5 sm:p-6 rounded-xl border border-red-500/30 bg-red-500/10 dark:bg-red-950/30 space-y-3">
            <h3 class="text-lg font-bold text-red-600 dark:text-red-400">Reporting CSAM</h3>
            <p class="text-sm text-foreground/90">
              If you encounter any content that may constitute CSAM or child exploitation, please report it immediately:
            </p>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="font-semibold text-foreground">Email:</span>
                <a href="mailto:complaint@lupyd.com" class="text-red-600 dark:text-red-400 underline hover:opacity-80">
                  complaint@lupyd.com
                </a>
              </li>
              <li class="flex items-center gap-2">
                <span class="font-semibold text-foreground">NCMEC CyberTipline:</span>
                <a
                  href="https://www.cybertipline.org"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-red-600 dark:text-red-400 underline hover:opacity-80"
                >
                  www.cybertipline.org
                </a>
              </li>
            </ul>
          </div>

          <p class="text-sm text-muted-foreground leading-relaxed">
            <strong class="text-foreground">Legal Consequences:</strong> Violations of this policy may result in criminal prosecution. CSAM-related offenses are serious crimes punishable by imprisonment and other severe penalties under federal and international law.
          </p>
        </section>

        <!-- Intellectual Property -->
        <section id="intellectual-property" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Intellectual Property Rights</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <p class="text-sm sm:text-base text-muted-foreground">
              All content on Lupyd, including text, graphics, logos, images, and software, is the property of Lupyd or its content suppliers and is protected by international copyright laws.
            </p>
            <p class="text-sm sm:text-base text-muted-foreground">
              You are granted a limited, non-exclusive, non-transferable license to access and use the Service for personal, non-commercial purposes. You may not reproduce, distribute, modify, or transmit any content without our prior written consent.
            </p>
            <p class="text-sm sm:text-base text-muted-foreground">
              Lupyd respects intellectual property rights and will respond to valid DMCA notices. If you believe your intellectual property has been infringed, please contact us with detailed information.
            </p>
          </div>
        </section>

        <!-- User Content -->
        <section id="user-content" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">User-Generated Content</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <p class="text-sm sm:text-base text-muted-foreground">
              By posting, uploading, or sharing content on Lupyd, you grant us a worldwide, non-exclusive, royalty-free license to use, reproduce, modify, and distribute your content.
            </p>
            <p class="text-sm font-semibold text-foreground">You represent and warrant that:</p>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>You own or have the right to use the content</li>
              <li>The content does not infringe any third-party rights</li>
              <li>The content complies with all applicable laws</li>
              <li>The content does not contain malware or harmful code</li>
            </ul>
            <p class="text-sm sm:text-base text-muted-foreground pt-2">
              We reserve the right to remove any content that violates these Terms or our policies.
            </p>
          </div>
        </section>

        <!-- Limitation of Liability -->
        <section id="limitation-liability" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Limitation of Liability</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3 text-sm sm:text-base text-muted-foreground">
            <p class="font-semibold uppercase tracking-wide text-foreground">
              TO THE MAXIMUM EXTENT PERMITTED BY LAW, LUPYD SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING LOSS OF PROFITS, DATA, OR USE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
            </p>
            <p class="font-semibold uppercase tracking-wide text-foreground">
              OUR TOTAL LIABILITY TO YOU FOR ANY CLAIM ARISING FROM OR RELATING TO THESE TERMS OR YOUR USE OF THE SERVICE SHALL NOT EXCEED THE AMOUNT YOU PAID TO US IN THE TWELVE MONTHS PRECEDING THE CLAIM, OR $100, WHICHEVER IS GREATER.
            </p>
            <p>
              Some jurisdictions do not allow the exclusion of certain warranties or the limitation of liability, so some of the above limitations may not apply to you.
            </p>
          </div>
        </section>

        <!-- Indemnification -->
        <section id="indemnification" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Indemnification</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30">
            <p class="text-sm sm:text-base text-muted-foreground">
              You agree to indemnify, defend, and hold harmless Lupyd and its officers, directors, employees, and agents from any claims, damages, losses, or expenses (including reasonable attorneys' fees) arising from or related to your use of the Service, your violation of these Terms, or your infringement of any third-party rights.
            </p>
          </div>
        </section>

        <!-- Termination -->
        <section id="termination" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Termination</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3 text-sm sm:text-base text-muted-foreground">
            <p>
              We may terminate or suspend your account and access to the Service immediately, without prior notice or liability, for any reason, including if you breach these Terms or engage in conduct we deem harmful to the Service or other users.
            </p>
            <p>
              Upon termination, your right to use the Service will cease immediately. We may retain certain information as required by law or for legitimate business purposes.
            </p>
          </div>
        </section>

        <!-- Dispute Resolution -->
        <section id="dispute-resolution" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Dispute Resolution</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3 text-sm sm:text-base text-muted-foreground">
            <p>
              Any dispute arising from or relating to these Terms or your use of Lupyd shall be governed by and construed in accordance with the laws of the Indian Judiciary, without regard to its conflict of law principles.
            </p>
            <p>
              You and Lupyd agree to submit to the exclusive jurisdiction of the state and federal courts located in New Delhi, India, and waive any objection to venue or inconvenient forum.
            </p>
            <p>
              Before initiating legal proceedings, you agree to attempt to resolve any dispute through good-faith negotiation with our support team.
            </p>
          </div>
        </section>

        <!-- Contact Us -->
        <section id="contact-us" class="scroll-mt-36 space-y-4 pt-6 border-t border-border/60">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Contact Us</h2>
          <p class="text-sm text-muted-foreground">
            If you have questions about these Terms of Use or need to report a violation, please contact us:
          </p>

          <div class="p-6 rounded-xl border border-border/60 bg-card/40 space-y-4">
            <div>
              <p class="font-bold text-foreground">Lupyd Legal Team</p>
              <p class="text-sm">
                <span class="font-semibold text-foreground">Email:</span>{" "}
                <a href="mailto:contact@lupyd.com" class="text-primary underline hover:opacity-80">
                  contact@lupyd.com
                </a>
              </p>
            </div>
            <div>
              <p class="font-bold text-sm text-foreground">Mailing Address</p>
              <p class="text-sm text-muted-foreground">
                Lupyd<br />
                Khanapuram<br />
                Khammam, India.
              </p>
            </div>
            <div>
              <p class="font-bold text-sm text-foreground">Response Time</p>
              <p class="text-sm text-muted-foreground">We aim to respond to all inquiries within 30 days.</p>
            </div>
          </div>
        </section>

        <!-- Footer Notice -->
        <div class="pt-8 border-t border-border/40 text-xs text-muted-foreground leading-relaxed">
          <p>
            These Terms of Use may be updated from time to time. We will notify you of any material changes by posting the new Terms on this page and updating the &ldquo;Last updated&rdquo; date. Your continued use of the Service following the posting of revised Terms means that you accept and agree to the changes.
          </p>
        </div>
      </main>
    </div>
  </div>

  <script>
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section[id]'));

    // IntersectionObserver for TOC highlight
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              const isActive = link.getAttribute('data-section') === id;
              if (isActive) {
                link.classList.remove('text-muted-foreground', 'hover:bg-muted/60');
                link.classList.add('font-semibold', 'bg-foreground', 'text-background');
              } else {
                link.classList.remove('font-semibold', 'bg-foreground', 'text-background');
                link.classList.add('text-muted-foreground', 'hover:bg-muted/60');
              }
            });
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    sections.forEach((section) => observer.observe(section));
  </script>
</Layout>
