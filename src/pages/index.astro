---
import Layout from "../layouts/Layout.astro";
import ScreenshotCarousel from "../components/ScreenshotCarousel.astro";
---

<Layout
  title="Lupyd : Private by design. Connected by default. Collaborative Platform"
  description="The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption, not bolted on as an afterthought."
>

<!-- ════════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════ -->
<section class="w-full py-12 md:py-16 lg:py-24 overflow-hidden">
  <div class="mx-auto px-6 max-w-7xl">
    <div class="max-w-3xl space-y-6 anim-hero" style="animation-delay:0.08s">
      <!-- Headline -->
      <h1 class="font-extrabold tracking-tight leading-[1.08] text-foreground
                 text-[clamp(2.1rem,4vw,3.5rem)]">
        Lupyd : Private by design.<br />
        <span class="text-muted-foreground">Connected by default. Collaborative Platform</span>
      </h1>

      <!-- Sub / Description -->
      <p class="text-muted-foreground leading-relaxed
                text-[clamp(0.95rem,1.25vw,1.1rem)]">
        The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption, not bolted on as an afterthought.
      </p>

      <!-- CTAs -->
      <div class="pt-2 flex flex-wrap items-center gap-3">
        <a href="https://lupyd.com"
           class="inline-flex items-center justify-center rounded-md font-semibold transition-all
                  bg-primary text-primary-foreground hover:opacity-88 active:scale-[0.98]
                  h-11 px-7 text-sm shadow-sm">
          Get Started
        </a>
        <a href="https://download.lupyd.com"
           class="inline-flex items-center justify-center rounded-md font-semibold transition-all
                  border border-border bg-background hover:bg-muted active:scale-[0.98]
                  h-11 px-7 text-sm">
          Download Now
        </a>
      </div>

      <!-- Security Badge -->
      <div class="flex items-center gap-2 pt-1 text-xs text-muted-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="text-foreground shrink-0">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span>End-to-End Encrypted &bull; Zero-Knowledge Architecture</span>
      </div>
    </div>
  </div>
</section>



<!-- ════════════════════════════════════════════════════════════
     FINAL CTA
════════════════════════════════════════════════════════════ -->
<section class="w-full py-24 md:py-32 border-t border-border/30">
  <div class="mx-auto px-6 max-w-2xl text-center sr">
    <h2 class="font-extrabold tracking-tight text-foreground
               text-[clamp(1.8rem,4vw,3rem)] leading-tight">
      Ready to join Lupyd?
    </h2>
    <p class="mt-4 text-muted-foreground text-sm leading-relaxed">
      Social when you want it. Collaborative when you need it. Private by design.
    </p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <a href="https://lupyd.com"
         class="inline-flex items-center justify-center rounded-md text-sm font-semibold
                bg-primary text-primary-foreground hover:opacity-88 transition-all h-11 px-8 shadow-sm">
        Get Started
      </a>
      <a href="https://download.lupyd.com"
         class="inline-flex items-center justify-center rounded-md text-sm font-semibold
                border border-border bg-background hover:bg-muted transition-colors h-11 px-8">
        Download Now
      </a>
    </div>
  </div>
</section>

</Layout>

<script>
  // Scroll reveal
  function initSR() {
    const els = document.querySelectorAll('.sr');
    if (!('IntersectionObserver' in window)) {
      els.forEach(el => el.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -32px 0px' });
    els.forEach(el => io.observe(el));
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initSR)
    : initSR();
  document.addEventListener('astro:page-load', initSR);
</script>
