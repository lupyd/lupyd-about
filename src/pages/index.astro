    color: hsl(var(--background));
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .showcase-panel {
    transition: opacity 0.2s ease;
  }
</style>
