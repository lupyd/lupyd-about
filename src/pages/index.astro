<script>
  // Scroll reveal
  function initSR() {
    const els = document.querySelectorAll('.sr');
    if (!('IntersectionObserver' in window)) {
      els.forEach(el => el.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -32px 0px' });
    els.forEach(el => io.observe(el));
  }

  // Showcase Tabs & Device Toggle
  function initShowcase() {
    const tabButtons = document.querySelectorAll('.showcase-tab-btn');
    const panels = document.querySelectorAll('.showcase-panel');
    const deviceButtons = document.querySelectorAll('.device-toggle-btn');
    const desktopFrames = document.querySelectorAll('.desktop-frame');
    const mobileFrames = document.querySelectorAll('.mobile-frame');

    tabButtons.forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-tab');

        tabButtons.forEach(b => {
          const active = b === btn;
          b.setAttribute('aria-selected', String(active));
          b.classList.toggle('is-active', active);
          b.classList.toggle('bg-foreground', active);
          b.classList.toggle('text-background', active);
          b.classList.toggle('border-foreground', active);
          b.classList.toggle('bg-card', !active);
          b.classList.toggle('text-muted-foreground', !active);
          b.classList.toggle('border-border', !active);
        });

        panels.forEach(p => {
          const match = p.id === `showcase-panel-${tabId}`;
          p.classList.toggle('hidden', !match);
          p.classList.toggle('active', match);
        });
      });
    });

    deviceButtons.forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const device = btn.getAttribute('data-device');
        const isDesktop = device === 'desktop';

        deviceButtons.forEach(b => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.classList.toggle('bg-foreground', active);
          b.classList.toggle('text-background', active);
          b.classList.toggle('text-muted-foreground', !active);
          b.setAttribute('aria-pressed', String(active));
        });

        desktopFrames.forEach(f => f.classList.toggle('hidden', !isDesktop));
        mobileFrames.forEach(f => f.classList.toggle('hidden', isDesktop));
      });
    });
  }

  [initSR, initShowcase].forEach((fn) => {
    document.readyState === 'loading'
      ? document.addEventListener('DOMContentLoaded', fn)
      : fn();
    document.addEventListener('astro:page-load', fn);
  });
</script>

