---
import Layout from "../layouts/Layout.astro";
import DeviceHeroMockup from "../components/DeviceHeroMockup.astro";

const siteBase = (Astro.site ? new URL(Astro.site).origin : "https://www.lupyd.com").replace(/\/$/, "");

const softwareSchema = {
  "@type": "SoftwareApplication",
  "@id": "https://www.lupyd.com/#software",
  "name": "Lupyd",
  "operatingSystem": "macOS, Windows, Linux, Android",
  "applicationCategory": "CommunicationApplication, SecurityApplication",
  "description": "The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and collaborate with Signal Protocol and MLS encryption.",
  "url": "https://www.lupyd.com",
  "downloadUrl": "https://download.lupyd.com",
  "publisher": {
    "@type": "Organization",
    "name": "Lupyd Media Private Limited",
    "url": "https://www.lupyd.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "15-18-276/5/A/1, Prashanti Nagar 2",
      "addressLocality": "Khammam",
      "addressRegion": "Telangana",
      "postalCode": "507002",
      "addressCountry": "IN"
    }
  },
  "areaServed": ["IN", "Worldwide"],
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Signal Protocol for 1-on-1 conversations",
    "Messaging Layer Security (MLS) for group chats",
    "AES Encryption for files and chat backups",
    "Custom channels and arbitrary roles",
    "Multi-device synchronization",
    "Local full-text search"
  ]
};

const landingFaqs = [
  {
    question: "What encryption protocols does Lupyd use?",
    answer: "Lupyd uses the Signal Protocol for direct one-on-one conversations and Messaging Layer Security (MLS) for group chats. Shared files, attachments, and chat backups are protected with AES encryption. Keys remain on your devices."
  },
  {
    question: "How do custom channels and roles work?",
    answer: "There are no fixed roles like admin or moderator in Lupyd. You can create any custom role from scratch, give it any name, and attach any specific combination of permissions. Anything can be assigned to anyone, giving your workspace complete structural freedom."
  },
  {
    question: "Which platforms are currently supported?",
    answer: "Lupyd currently supports macOS, Windows, Linux, and Android. Support for iOS is in active development on our roadmap. We do not support web at this time."
  },
  {
    question: "Does Lupyd support multi-device use?",
    answer: "Yes. Lupyd supports multi-device synchronization, allowing you to use your account across your desktop and mobile devices while preserving end-to-end encryption."
  },
  {
    question: "How does full-text search work with encrypted messages?",
    answer: "Search queries run locally on your device against an on-device inverted index. Your search terms never leave your hardware and are never sent to a remote server."
  },
  {
    question: "Are there ads, tracking, or algorithmic feeds?",
    answer: "No. Lupyd is completely ad-free, runs zero tracking or telemetry, and maintains a strict chronological conversation feed."
  }
];

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${siteBase}/#faq`,
  "mainEntity": landingFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const pageSchemas = [softwareSchema, faqSchema];

const getDesktopLightSrc = (src: string) => src.replace('-dark.webp', '.webp');
const getMobileLightSrc = (src: string) => src.replace('-dark.webp', '.webp');

const getDesktopSrcset = (src: string) => {
  const base = src.replace(/\.webp$/, '');
  return `${base}-640.webp 640w, ${base}-1024.webp 1024w, ${src} 1440w`;
};

const getMobileSrcset = (src: string) => {
  const base = src.replace(/\.webp$/, '');
  return `${base}-360.webp 360w, ${base}-540.webp 540w, ${src} 780w`;
};

const showcaseTabs = [
  {
    id: "channels",
    name: "Channels",
    title: "Custom Channels & Workspaces",
    description: "Organize conversations into distinct public or private channels. Structure your workspace to fit how your team actually works.",
    bullets: ["Public & private channels", "Real-time updates", "Multi-device sync"],
    desktopSrc: "/screenshots/desktop/group-channel-dark.webp",
    desktopAlt: "Lupyd Channels Desktop Interface",
    mobileSrc: "/screenshots/mobile/group-channel-dark.webp",
    mobileAlt: "Lupyd Channels Mobile Interface"
  },
  {
    id: "channel-create",
    name: "Channel Creation",
    title: "On-the-Fly Channel Configuration",
    description: "Create text, voice, or announcement channels instantly. Set custom channel topics and granular member access with client-side encryption.",
    bullets: ["Text, Voice, & Announcement types", "Granular channel privacy", "Custom topics"],
    desktopSrc: "/screenshots/desktop/channel-create-dark.webp",
    desktopAlt: "Lupyd Channel Creation Interface",
    mobileSrc: "/screenshots/mobile/channel-create-dark.webp",
    mobileAlt: "Lupyd Channel Creation Mobile Interface"
  },
  {
    id: "roles",
    name: "Roles & Permissions",
    title: "Arbitrary Roles & Fine-Grained Permissions",
    description: "No locked role hierarchies like admin or moderator. Define any role name from scratch and attach any combination of permissions. Anything can be assigned to anyone.",
    bullets: ["Zero fixed role hierarchies", "Granular permission flags", "Custom role colors & tags"],
    desktopSrc: "/screenshots/desktop/roles-dark.webp",
    desktopAlt: "Lupyd Roles and Permissions Interface",
    mobileSrc: "/screenshots/mobile/roles-dark.webp",
    mobileAlt: "Lupyd Roles Mobile Interface"
  },
  {
    id: "role-assignment",
    name: "Role Assignment",
    title: "Member Invitations & Role Allocation",
    description: "Invite team members directly to workspaces and assign customized roles with explicit access rights. Revoke or reconfigure permissions at any time.",
    bullets: ["Direct member invitations", "Instant role allocation", "Access control"],
    desktopSrc: "/screenshots/desktop/role-assignment-dark.webp",
    desktopAlt: "Lupyd Role Assignment Interface",
    mobileSrc: "/screenshots/mobile/role-assignment-dark.webp",
    mobileAlt: "Lupyd Role Assignment Mobile Interface"
  },
  {
    id: "dm",
    name: "Direct Messages",
    title: "Signal Protocol 1-on-1 Conversations",
    description: "End-to-end encrypted direct messaging using the Signal Protocol. Fast, private communication where only you and your recipient hold the keys.",
    bullets: ["Signal Protocol encryption", "Instant delivery", "Multi-device sync"],
    desktopSrc: "/screenshots/desktop/dm-dark.webp",
    desktopAlt: "Lupyd Direct Messaging Desktop Interface",
    mobileSrc: "/screenshots/mobile/dm-dark.webp",
    mobileAlt: "Lupyd Direct Messaging Mobile Interface"
  },
  {
    id: "search",
    name: "Full-Text Search",
    title: "Local Full-Text Search",
    description: "Search across direct messages, groups, and channels in milliseconds using an on-device SQLite index. Search queries never leave your device.",
    bullets: ["On-device SQLite index", "Filter by chats & groups", "Zero server leakage"],
    desktopSrc: "/screenshots/desktop/search-dark.webp",
    desktopAlt: "Lupyd Full-Text Search Desktop Interface",
    mobileSrc: "/screenshots/mobile/search-dark.webp",
    mobileAlt: "Lupyd Full-Text Search Mobile Interface"
  },
  {
    id: "calls",
    name: "Voice & Video",
    title: "Direct Voice & Video Calling",
    description: "Encrypted voice and video calls built straight into your channels and direct conversations with screen sharing.",
    bullets: ["Encrypted audio & video", "Low-latency streaming", "Screen sharing"],
    desktopSrc: "/screenshots/desktop/calls-dark.webp",
    desktopAlt: "Lupyd Calling Desktop Interface",
    mobileSrc: "/screenshots/mobile/calls-dark.webp",
    mobileAlt: "Lupyd Calling Mobile Interface"
  },
  {
    id: "media",
    name: "Files & Backups",
    title: "AES Encrypted Files & Backups",
    description: "Send project files, code, and documents with client-side AES encryption. Export and restore encrypted chat backups.",
    bullets: ["AES encrypted file uploads", "Inline file preview", "Encrypted backups"],
    desktopSrc: "/screenshots/desktop/media-dark.webp",
    desktopAlt: "Lupyd Media and Files Desktop Interface",
    mobileSrc: "/screenshots/mobile/media-dark.webp",
    mobileAlt: "Lupyd Media Mobile Interface"
  },
  {
    id: "settings",
    name: "Settings",
    title: "Account & Device Controls",
    description: "Manage your active devices, cryptographic keys, notification preferences, and workspace settings with zero surveillance.",
    bullets: ["Multi-device management", "Zero tracking telemetry", "Notification controls"],
    desktopSrc: "/screenshots/desktop/settings-dark.webp",
    desktopAlt: "Lupyd Settings Desktop Interface",
    mobileSrc: "/screenshots/mobile/settings-dark.webp",
    mobileAlt: "Lupyd Settings Mobile Interface"
  }
];
---

<Layout
  title="Lupyd : Private by design. Connected by default. Collaborative Platform"
  description="The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and collaborate with Signal Protocol and MLS encryption."
  pageType="AboutPage"
  schema={pageSchemas}
>

<!-- ════════════════════════════════════════════════════════════
     1. HERO SECTION
════════════════════════════════════════════════════════════ -->
<section class="w-full py-12 md:py-16 lg:py-20 overflow-hidden relative">
  <div class="mx-auto px-6 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 xl:gap-12 items-center">
      <!-- Left: Content -->
      <div class="lg:col-span-6 xl:col-span-6 space-y-6 anim-hero" style="animation-delay:0.08s">
        <!-- Headline -->
        <h1 class="font-extrabold tracking-tight leading-[1.08] text-foreground text-[clamp(2.1rem,3.8vw,3.4rem)]">
          Lupyd : Private by design.<br />
          <span class="text-muted-foreground">Connected by default. Collaborative Platform</span>
        </h1>

        <!-- Sub / Description -->
        <p class="text-muted-foreground leading-relaxed text-[clamp(0.95rem,1.2vw,1.05rem)]">
          The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption, not bolted on as an afterthought.
        </p>

        <!-- CTAs -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a href="https://lupyd.com"
             class="inline-flex items-center justify-center rounded-md font-semibold transition-all
                    bg-primary text-primary-foreground hover:opacity-88 active:scale-[0.98]
                    h-11 px-7 text-sm shadow-sm">
            Get Started
          </a>
          <a href="https://download.lupyd.com"
             class="inline-flex items-center justify-center rounded-md font-semibold transition-all
                    border border-border bg-background hover:bg-muted active:scale-[0.98]
                    h-11 px-7 text-sm">
            Download App
          </a>
          <a href="/features"
             class="inline-flex items-center justify-center rounded-md font-semibold transition-all
                    text-muted-foreground hover:text-foreground hover:bg-muted/50
                    h-11 px-5 text-sm gap-1.5">
            Features
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Monotonic Technical Specs Strip -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-5 pt-1 text-xs text-muted-foreground">
          <span>Signal Protocol (1-on-1)</span>
          <span class="text-border">&bull;</span>
          <span>MLS (Group Chats)</span>
          <span class="text-border">&bull;</span>
          <span>AES (Files &amp; Backups)</span>
          <span class="text-border">&bull;</span>
          <span>Multi-Device</span>
        </div>
      </div>

      <!-- Right: Authentic MacBook Pro 16 + Overlaid Mobile with Camera Notch & Status Bar -->
      <div class="lg:col-span-6 xl:col-span-6 anim-hero w-full" style="animation-delay:0.18s">
        <DeviceHeroMockup
          desktopSrc="/screenshots/desktop/group-channel-dark.webp"
          desktopAlt="Lupyd Desktop Application showing channels and workspaces"
          mobileSrc="/screenshots/mobile/group-channel-dark.webp"
          mobileAlt="Lupyd Mobile Application showing encrypted conversation"
        />
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════
     2. TECHNICAL SPECIFICATIONS BAR
════════════════════════════════════════════════════════════ -->
<section class="w-full py-8 border-y border-border/40 bg-muted/20">
  <div class="mx-auto px-6 max-w-7xl">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-center sr">
      <div class="space-y-1">
        <div class="text-xl sm:text-2xl font-bold text-foreground">Signal Protocol</div>
        <div class="text-xs text-muted-foreground">1-on-1 End-to-End Encryption</div>
      </div>
      <div class="space-y-1">
        <div class="text-xl sm:text-2xl font-bold text-foreground">MLS</div>
        <div class="text-xs text-muted-foreground">Messaging Layer Security for Groups</div>
      </div>
      <div class="space-y-1">
        <div class="text-xl sm:text-2xl font-bold text-foreground">AES</div>
        <div class="text-xs text-muted-foreground">Encrypted Files &amp; Backups</div>
      </div>
      <div class="space-y-1">
        <div class="text-xl sm:text-2xl font-bold text-foreground">Multi-Device</div>
        <div class="text-xs text-muted-foreground">macOS, Windows, Linux, Android</div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════
     3. VISUAL PRODUCT SHOWCASE
════════════════════════════════════════════════════════════ -->
<section class="w-full py-16 md:py-24" id="showcase">
  <div class="mx-auto px-6 max-w-7xl">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-14 sr">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
        Workspace Interface
      </h2>
      <p class="mt-3 text-base text-muted-foreground">
        Screenshots of Lupyd across desktop and mobile.
      </p>

      <!-- Device View Toggle: Desktop ⇄ Mobile -->
      <div class="mt-6 inline-flex items-center p-1 rounded-lg border border-border bg-card">
        <button
          type="button"
          class="device-toggle-btn active flex items-center gap-2 px-4 py-1.5 rounded-md text-xs font-semibold transition-all"
          data-device="desktop"
          aria-pressed="true"
        >
          Desktop
        </button>
        <button
          type="button"
          class="device-toggle-btn flex items-center gap-2 px-4 py-1.5 rounded-md text-xs font-semibold transition-all text-muted-foreground hover:text-foreground"
          data-device="mobile"
          aria-pressed="false"
        >
          Mobile
        </button>
      </div>
    </div>

    <!-- Category Tabs Selector -->
    <div class="flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto mb-8 px-4 sr">
      {showcaseTabs.map((tab, idx) => (
        <button
          type="button"
          class={`showcase-tab-btn px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-lg text-xs sm:text-sm font-semibold transition-all border ${idx === 0 ? 'is-active bg-foreground text-background border-foreground' : 'bg-card text-muted-foreground border-border hover:text-foreground hover:border-foreground/30'}`}
          data-tab={tab.id}
          aria-selected={idx === 0 ? "true" : "false"}
        >
          {tab.name}
        </button>
      ))}
    </div>

    <!-- Showcase Display Card Container -->
    <div class="sr">
      {showcaseTabs.map((tab, idx) => (
        <div
          class={`showcase-panel ${idx === 0 ? 'active' : 'hidden'}`}
          id={`showcase-panel-${tab.id}`}
        >
          <div class="rounded-xl border border-border bg-card p-6 md:p-8">
            <!-- Contextual Info Header -->
            <div class="max-w-2xl mb-6 space-y-2">
              <h3 class="text-lg sm:text-xl font-bold text-foreground">
                {tab.title}
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">
                {tab.description}
              </p>
              <div class="flex flex-wrap items-center gap-2 pt-1">
                {tab.bullets.map((b) => (
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-xs bg-muted text-foreground/80 border border-border">
                    <span class="w-1 h-1 rounded-full bg-foreground/40"></span>
                    {b}
                  </span>
                ))}
              </div>
            </div>

            <!-- Viewport Stage -->
            <div class="showcase-stage flex justify-center items-center">
              
              <!-- Desktop Frame (Window: clean dots + Lupyd title, no URLs, no E2EE labels, NO hover zoom) -->
              <div class="desktop-frame w-full max-w-5xl rounded-lg border border-border bg-card overflow-hidden shadow-sm">
                <!-- Desktop Chrome Bar -->
                <div class="flex items-center justify-between px-3.5 py-2 border-b border-border bg-muted/30 select-none">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-border inline-block"></span>
                    <span class="w-2 h-2 rounded-full bg-border inline-block"></span>
                    <span class="w-2 h-2 rounded-full bg-border inline-block"></span>
                  </div>
                  <div class="text-xs font-medium text-muted-foreground tracking-tight">
                    Lupyd
                  </div>
                  <div class="w-8"></div>
                </div>
                <!-- Image - Never zooms on hover -->
                <div class="relative aspect-[16/10] bg-background overflow-hidden">
                  <!-- Dark mode desktop screenshot -->
                  <img
                    src={tab.desktopSrc}
                    srcset={getDesktopSrcset(tab.desktopSrc)}
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1024px"
                    alt={tab.desktopAlt}
                    width="1440"
                    height="900"
                    loading="lazy"
                    class="hidden dark:block w-full h-full object-cover object-top"
                  />
                  <!-- Light mode desktop screenshot -->
                  <img
                    src={getDesktopLightSrc(tab.desktopSrc)}
                    srcset={getDesktopSrcset(getDesktopLightSrc(tab.desktopSrc))}
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1024px"
                    alt={tab.desktopAlt}
                    width="1440"
                    height="900"
                    loading="lazy"
                    class="block dark:hidden w-full h-full object-cover object-top"
                  />
                </div>
              </div>

              <!-- Mobile Frame (Shown when Mobile toggle is active, with Notification Bar & Camera Notch, NO hover zoom) -->
              <div class="mobile-frame hidden w-[300px] sm:w-[320px] rounded-[36px] border border-border bg-card p-2 shadow-2xl">
                <div class="relative rounded-[28px] overflow-hidden border border-border/80 bg-neutral-950 aspect-[9/19.5] flex flex-col">
                  <!-- Mobile Status / Notification Bar -->
                  <div class="relative z-20 w-full px-3 pt-2 pb-1 flex items-center justify-between text-neutral-700 dark:text-neutral-300 select-none bg-white/80 dark:bg-neutral-950/80 backdrop-blur-xs border-b border-border/50 dark:border-neutral-800/40">
                    <div class="text-[10px] font-semibold tracking-tight text-neutral-800 dark:text-neutral-200">9:41</div>
                    <!-- Camera Notch / Punch Hole -->
                    <div class="absolute left-1/2 -translate-x-1/2 top-2 flex items-center justify-center" aria-hidden="true">
                      <div class="w-2.5 h-2.5 rounded-full bg-neutral-900 border border-neutral-700 dark:border-neutral-800 shadow-inner flex items-center justify-center">
                        <span class="w-1 h-1 rounded-full bg-neutral-950 ring-1 ring-cyan-950/40"></span>
                      </div>
                    </div>
                    <div class="flex items-center gap-1.5 opacity-80" aria-hidden="true">
                      <!-- Cellular Signal -->
                      <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 16 16">
                        <rect x="1" y="11" width="2" height="4" rx="0.5"></rect>
                        <rect x="5" y="8" width="2" height="7" rx="0.5"></rect>
                        <rect x="9" y="5" width="2" height="10" rx="0.5"></rect>
                        <rect x="13" y="2" width="2" height="13" rx="0.5"></rect>
                      </svg>
                      <!-- Wi-Fi -->
                      <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 16 16">
                        <path d="M8 12.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm-4.24-2.83a6 6 0 0 1 8.48 0 .75.75 0 1 1-1.06 1.06 4.5 4.5 0 0 0-6.36 0 .75.75 0 1 1-1.06-1.06zm-2.83-2.83a10 10 0 0 1 14.14 0 .75.75 0 1 1-1.06 1.06 8.5 8.5 0 0 0-12.02 0 .75.75 0 0 1-1.06-1.06z"></path>
                      </svg>
                      <!-- Battery -->
                      <div class="flex items-center">
                        <div class="w-3.5 h-2 rounded-[2px] border border-current p-[1px] flex items-center">
                          <div class="w-full h-full bg-current rounded-[1px]"></div>
                        </div>
                        <div class="w-[1px] h-1 bg-current rounded-r-[1px]"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Image - Never zooms on hover -->
                  <div class="relative flex-1 w-full overflow-hidden bg-background">
                    <!-- Dark mode mobile screenshot -->
                    <img
                      src={tab.mobileSrc}
                      srcset={getMobileSrcset(tab.mobileSrc)}
                      sizes="(max-width: 640px) 90vw, 320px"
                      alt={tab.mobileAlt}
                      width="750"
                      height="1624"
                      loading="lazy"
                      class="hidden dark:block w-full h-full object-cover object-top"
                    />
                    <!-- Light mode mobile screenshot -->
                    <img
                      src={getMobileLightSrc(tab.mobileSrc)}
                      srcset={getMobileSrcset(getMobileLightSrc(tab.mobileSrc))}
                      sizes="(max-width: 640px) 90vw, 320px"
                      alt={tab.mobileAlt}
                      width="750"
                      height="1624"
                      loading="lazy"
                      class="block dark:hidden w-full h-full object-cover object-top"
                    />
                  </div>

                  <!-- Android Home Navigation Pill Indicator -->
                  <div class="relative z-20 w-full py-1.5 flex justify-center bg-neutral-100 dark:bg-neutral-950 select-none pointer-events-none" aria-hidden="true">
                    <div class="w-14 h-1 rounded-full bg-neutral-400 dark:bg-neutral-500/60"></div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════
     4. CORE CAPABILITIES (MONOTONIC & PRECISE)
════════════════════════════════════════════════════════════ -->
<section class="w-full py-16 md:py-24 border-t border-border/30 bg-muted/10">
  <div class="mx-auto px-6 max-w-7xl">
    <div class="max-w-3xl mx-auto text-center mb-12 md:mb-16 sr">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
        Core Architecture
      </h2>
      <p class="mt-3 text-base text-muted-foreground">
        Built for private communication, flexible workspace structure, and direct performance.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sr">
      
      <!-- Card 1: Signal Protocol & MLS -->
      <div class="lg:col-span-2 rounded-xl border border-border bg-card p-6 md:p-8 space-y-3">
        <div class="font-mono text-xs text-muted-foreground">01 / ENCRYPTION</div>
        <h3 class="text-xl font-bold text-foreground">
          Signal Protocol &amp; Messaging Layer Security (MLS)
        </h3>
        <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
          One-on-one direct messages are encrypted with the Signal Protocol. Group conversations scale securely with Messaging Layer Security (MLS). All shared files, attachments, and chat backups are protected with client-side AES encryption. Decryption keys remain exclusively on your devices.
        </p>
      </div>

      <!-- Card 2: Custom Channels & Arbitrary Roles -->
      <div class="rounded-xl border border-border bg-card p-6 md:p-8 space-y-3">
        <div class="font-mono text-xs text-muted-foreground">02 / STRUCTURE</div>
        <h3 class="text-xl font-bold text-foreground">
          Custom Channels &amp; Arbitrary Roles
        </h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          There are no locked, predefined roles like admin or moderator. You can define any role from scratch and attach any combination of permissions. Anything can be assigned to anyone.
        </p>
      </div>

