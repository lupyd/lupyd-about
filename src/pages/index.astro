---
import Layout from "../layouts/Layout.astro";
import ScreenshotCarousel from "../components/ScreenshotCarousel.astro";

const softwareSchema = {
  "@type": "SoftwareApplication",
  "@id": "https://www.lupyd.com/#software",
  "name": "Lupyd",
  "operatingSystem": "Web, macOS, Windows, Linux, iOS, Android",
  "applicationCategory": "CommunicationApplication, SecurityApplication",
  "description": "The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption.",
  "url": "https://www.lupyd.com",
  "downloadUrl": "https://download.lupyd.com",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "End-to-End Encryption",
    "Zero-Knowledge Architecture",
    "Team Channels & Messaging",
    "Secure File Sharing",
    "Cross-Platform Sync"
  ]
};
---

<Layout
  title="Lupyd : Private by design. Connected by default. Collaborative Platform"
  description="The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption, not bolted on as an afterthought."
  pageType="AboutPage"
  schema={softwareSchema}
>

<!-- ════════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════ -->
<section class="w-full py-12 md:py-16 lg:py-20 overflow-hidden relative">
  <div class="mx-auto px-6 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 xl:gap-12 items-center">
      <!-- Left: Content -->
      <div class="lg:col-span-6 xl:col-span-6 space-y-6 anim-hero" style="animation-delay:0.08s">
        <!-- Headline -->
        <h1 class="font-extrabold tracking-tight leading-[1.08] text-foreground
                   text-[clamp(2.1rem,3.8vw,3.4rem)]">
          Lupyd : Private by design.<br />
          <span class="text-muted-foreground">Connected by default. Collaborative Platform</span>
        </h1>

        <!-- Sub / Description -->
        <p class="text-muted-foreground leading-relaxed
                  text-[clamp(0.95rem,1.2vw,1.05rem)]">
          The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption, not bolted on as an afterthought.
        </p>

        <!-- CTAs -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a href="https://lupyd.com"
             class="inline-flex items-center justify-center rounded-md font-semibold transition-all
                    bg-primary text-primary-foreground hover:opacity-88 active:scale-[0.98]
                    h-11 px-7 text-sm shadow-sm">
            Get Started
          </a>
          <a href="https://download.lupyd.com"
             class="inline-flex items-center justify-center rounded-md font-semibold transition-all
                    border border-border bg-background hover:bg-muted active:scale-[0.98]
                    h-11 px-7 text-sm">
            Download Now
          </a>
        </div>

        <!-- Security Badge -->
        <div class="flex items-center gap-2 pt-1 text-xs text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="text-foreground shrink-0">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>End-to-End Encrypted &bull; Zero-Knowledge Architecture</span>
        </div>
      </div>

      <!-- Right: Procedural Skewed 3D Laptop Mockup -->
      <div class="lg:col-span-6 xl:col-span-6 anim-hero hero-laptop-perspective" style="animation-delay:0.18s">
        <div class="laptop-assembly">
          <!-- Laptop Screen Lid -->
          <div class="laptop-lid">
            <!-- Camera Bezel -->
            <div class="laptop-camera-bar">
              <span class="laptop-camera-dot">
                <span class="camera-lens-glare"></span>
              </span>
            </div>

            <!-- Screen Viewport -->
            <div class="laptop-screen">
              <img
                src="/screenshots/desktop/group-channel.webp"
                alt="Lupyd Desktop Application"
                width="1440"
                height="900"
                class="w-full h-auto block select-none"
                loading="eager"
              />
            </div>
          </div>

          <!-- Laptop Hinge -->
          <div class="laptop-hinge" aria-hidden="true"></div>

          <!-- Laptop Keyboard Deck Base -->
          <div class="laptop-base" aria-hidden="true">
            <div class="laptop-keyboard-recess">
              <div class="laptop-keyboard-grid">
                <div class="key-row">
                  <span class="key key-esc"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key key-pwr"></span>
                </div>
                <div class="key-row">
                  <span class="key key-tab"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key key-del"></span>
                </div>
                <div class="key-row">
                  <span class="key key-caps"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key"></span><span class="key key-return"></span>
                </div>
                <div class="key-row">
                  <span class="key key-shift"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key"></span><span class="key"></span><span class="key"></span>
                  <span class="key"></span><span class="key key-shift-r"></span>
                </div>
                <div class="key-row">
                  <span class="key key-fn"></span><span class="key key-ctrl"></span><span class="key key-opt"></span><span class="key key-cmd"></span>
                  <span class="key key-space"></span>
                  <span class="key key-cmd"></span><span class="key key-opt"></span><span class="key key-arrows"></span>
                </div>
              </div>
            </div>

            <!-- Trackpad -->
            <div class="laptop-trackpad"></div>

            <!-- Opening Thumb Notch -->
            <div class="laptop-thumb-notch"></div>
          </div>

          <!-- Ambient Desk Shadow -->
          <div class="laptop-ambient-shadow" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</section>



<!-- ════════════════════════════════════════════════════════════
     FINAL CTA
════════════════════════════════════════════════════════════ -->
<section class="w-full py-24 md:py-32 border-t border-border/30">
  <div class="mx-auto px-6 max-w-2xl text-center sr">
    <h2 class="font-extrabold tracking-tight text-foreground
               text-[clamp(1.8rem,4vw,3rem)] leading-tight">
      Ready to join Lupyd?
    </h2>
    <p class="mt-4 text-muted-foreground text-sm leading-relaxed">
      Social when you want it. Collaborative when you need it. Private by design.
    </p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <a href="https://lupyd.com"
         class="inline-flex items-center justify-center rounded-md text-sm font-semibold
                bg-primary text-primary-foreground hover:opacity-88 transition-all h-11 px-8 shadow-sm">
        Get Started
      </a>
      <a href="https://download.lupyd.com"
         class="inline-flex items-center justify-center rounded-md text-sm font-semibold
                border border-border bg-background hover:bg-muted transition-colors h-11 px-8">
        Download Now
      </a>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════
     FEATURED ON (Badges)
════════════════════════════════════════════════════════════ -->
<section class="w-full py-12 md:py-16 border-t border-border/30 bg-muted/10">
  <div class="mx-auto px-6 max-w-5xl text-center sr">
    <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-6">
      Featured on
    </p>
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-8">
      <a
        href="https://kickproduct.com/products/6aba04f7992d87eba5b6a8f5"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center transition-all duration-200 hover:opacity-85 hover:scale-105 active:scale-95"
      >
        <img
          src="https://www.kickproduct.com/listedbadge.png"
          alt="Listed on Kick Product"
          width="250"
          class="h-11 sm:h-12 w-auto object-contain rounded-md"
        />
      </a>
      <a
        href="https://fazier.com/launches/www.lupyd.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center transition-all duration-200 hover:opacity-85 hover:scale-105 active:scale-95"
      >
        <img
          src="https://fazier.com/api/v1//public/badges/launch_badges.svg?badge_type=launched&theme=neutral"
          width="120"
          alt="Fazier badge"
          class="h-10 sm:h-11 w-auto object-contain rounded-md"
        />
      </a>
      <a
        href="https://www.producthunt.com/products/lupyd?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-lupyd"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center transition-all duration-200 hover:opacity-85 hover:scale-105 active:scale-95"
      >
        <img
          alt="Lupyd - Collaborative work needs to be secure? look no futher | Product Hunt"
          width="250"
          height="54"
          src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1073847&amp;theme=light&amp;t=1790579008506"
          class="h-11 sm:h-12 w-auto object-contain rounded-md"
        />
      </a>
    </div>
  </div>
</section>

</Layout>

<script>
  // Scroll reveal
  function initSR() {
    const els = document.querySelectorAll('.sr');
    if (!('IntersectionObserver' in window)) {
      els.forEach(el => el.classList.add('visible'));
      return;
    }
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -32px 0px' });
    els.forEach(el => io.observe(el));
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initSR)
    : initSR();
  document.addEventListener('astro:page-load', initSR);
</script>

<style>
  .hero-laptop-perspective {
    perspective: 1400px;
    perspective-origin: 30% 45%;
  }

  .laptop-assembly {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 3D Skew & Angle towards the viewer */
  @media (min-width: 1024px) {
    .laptop-assembly {
      transform: rotateY(-13deg) rotateX(7deg) rotateZ(-1.2deg) scale(0.96);
      transform-origin: center right;
    }

    .laptop-assembly:hover {
      transform: rotateY(-6deg) rotateX(3deg) rotateZ(0deg) scale(0.99) translateY(-4px);
    }
  }

  /* ─── Laptop Screen Lid ─────────────────────────────────── */
  .laptop-lid {
    position: relative;
    background: linear-gradient(155deg, #2b2e37 0%, #16171d 50%, #0d0e11 100%);
    border: 1.5px solid #3d414e;
    border-radius: 14px 14px 2px 2px;
    padding: 7px 7px 4px 7px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 20px 45px -10px rgba(0, 0, 0, 0.45),
      0 40px 90px -20px rgba(0, 0, 0, 0.35);
  }

  :global(.dark) .laptop-lid {
    background: linear-gradient(155deg, #22242c 0%, #131419 50%, #08090c 100%);
    border-color: #31353f;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 25px 60px -15px rgba(0, 0, 0, 0.8),
      0 55px 120px -25px rgba(0, 0, 0, 0.95);
  }

  .laptop-camera-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-bottom: 5px;
  }

  .laptop-camera-dot {
    position: relative;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #08090b;
    box-shadow: 0 0 0 0.5px rgba(255, 255, 255, 0.15), inset 0 1px 2px rgba(0, 0, 0, 0.8);
    display: inline-block;
  }

  .camera-lens-glare {
    position: absolute;
    top: 1px;
    left: 1px;
    width: 1.5px;
    height: 1.5px;
    border-radius: 50%;
    background: rgba(130, 175, 255, 0.7);
  }

  .laptop-screen {
    border-radius: 8px;
    overflow: hidden;
    background: hsl(var(--card));
    border: 1px solid rgba(0, 0, 0, 0.4);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .laptop-screen img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* ─── Laptop Hinge ──────────────────────────────────────── */
  .laptop-hinge {
    height: 4px;
    background: linear-gradient(to bottom, #111216, #090a0d);
    margin: 0 45px;
    border-radius: 1px 1px 0 0;
  }

  /* ─── Laptop Keyboard Deck Base ─────────────────────────── */
  .laptop-base {
    position: relative;
    background: linear-gradient(to bottom, #252831 0%, #1e2027 40%, #16171d 100%);
    border: 1px solid #363944;
    border-top: 1px solid #4a4f5d;
    border-radius: 2px 2px 16px 16px;
    padding: 8px 12px 6px;
    transform-origin: top center;
    transform: rotateX(32deg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 18px 40px -4px rgba(0, 0, 0, 0.55),
      0 4px 10px rgba(0, 0, 0, 0.35);
  }

  :global(.dark) .laptop-base {
    background: linear-gradient(to bottom, #1d1e25 0%, #16171d 40%, #0f1013 100%);
    border-color: #2b2e38;
    border-top-color: #3d414f;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 20px 48px -4px rgba(0, 0, 0, 0.75),
      0 6px 14px rgba(0, 0, 0, 0.5);
  }

  .laptop-keyboard-recess {
    background: #0f1014;
    border-radius: 5px;
    padding: 4px 5px;
    border: 0.5px solid rgba(0, 0, 0, 0.5);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.7);
  }

  .laptop-keyboard-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5px;
  }

  .key-row {
    display: flex;
    gap: 2.5px;
    align-items: center;
  }

  .key {
    flex: 1;
    height: 5.5px;
    background: #1e2026;
    border-radius: 1px;
    box-shadow: 0 0.5px 0 #0d0e12;
  }

  :global(.dark) .key {
    background: #18191f;
  }

  .key-esc { flex: 1.2; }
  .key-pwr { flex: 1.2; }
  .key-tab { flex: 1.4; }
  .key-del { flex: 1.4; }
  .key-caps { flex: 1.6; }
  .key-return { flex: 1.8; }
  .key-shift { flex: 2.1; }
  .key-shift-r { flex: 2.1; }
  .key-space { flex: 5.5; }
  .key-fn, .key-ctrl, .key-opt, .key-cmd { flex: 1.2; }
  .key-arrows { flex: 2; }

  /* Trackpad */
  .laptop-trackpad {
    width: 84px;
    height: 28px;
    margin: 6px auto 2px;
    border-radius: 4px;
    border: 0.5px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(to bottom, #1f2128, #18191f);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35);
  }

  :global(.dark) .laptop-trackpad {
    background: linear-gradient(to bottom, #17181e, #111216);
    border-color: rgba(255, 255, 255, 0.05);
  }

  /* Thumb Notch */
  .laptop-thumb-notch {
    width: 38px;
    height: 2px;
    margin: 3px auto 0;
    border-radius: 1px;
    background: rgba(0, 0, 0, 0.7);
    box-shadow: 0 0.5px 0 rgba(255, 255, 255, 0.08);
  }

  /* Desk Shadow */
  .laptop-ambient-shadow {
    width: 90%;
    height: 22px;
    margin: -6px auto 0;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0) 70%);
    filter: blur(7px);
  }
</style>



