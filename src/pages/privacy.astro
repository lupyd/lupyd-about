---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const sections = [
  { id: "introduction", title: "Introduction" },
  { id: "information-collection", title: "Information We Collect" },
  { id: "information-use", title: "How We Use Your Information" },
  { id: "information-sharing", title: "Information Sharing" },
  { id: "data-security", title: "Data Security" },
  { id: "user-rights", title: "Your Rights" },
  { id: "cookies", title: "Cookies & Tracking Technologies" },
  { id: "third-party", title: "Third-Party Services" },
  { id: "children", title: "Children's Privacy" },
  { id: "csam-policy", title: "Child Safety & CSAM Policy" },
  { id: "contact", title: "Contact Us" },
];

const siteBase = (Astro.site ? new URL(Astro.site).origin : "https://www.lupyd.com").replace(/\/$/, "");
const privacyDocSchema = {
  "@type": "DigitalDocument",
  "@id": `${siteBase}/privacy#document`,
  "name": "Lupyd Privacy Policy",
  "headline": "Privacy Policy - Lupyd",
  "description": "At Lupyd, we believe in transparency and protecting your privacy. This policy explains how we collect, use, and safeguard your information.",
  "url": `${siteBase}/privacy`,
  "dateModified": "2025-10-01",
  "inLanguage": "en-US",
  "publisher": {
    "@type": "Organization",
    "name": "Lupyd",
    "url": siteBase
  }
};
---

<Layout
  title="Privacy Policy - Lupyd"
  description="At Lupyd, we believe in transparency and protecting your privacy. This policy explains how we collect, use, and safeguard your personal information."
  pageType="WebPage"
  modifiedTime="2025-10-01"
  breadcrumbs={[
    { name: "Legal", href: "/privacy" },
    { name: "Privacy Policy", href: "/privacy" }
  ]}
  schema={privacyDocSchema}
>
  <!-- Legal Sub-nav Tabs -->
  <section class="border-b border-border/50 bg-background/60 backdrop-blur-md sticky top-16 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2 sm:gap-6 overflow-x-auto no-scrollbar py-1">
        <a
          href="/privacy"
          class="text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-full bg-foreground text-background transition-colors whitespace-nowrap"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-of-use"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Terms of Use
        </a>
        <a
          href="/terms-of-service"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Terms of Service
        </a>
      </div>
      <span class="hidden sm:inline-block text-xs text-muted-foreground font-mono">Last updated: Oct 2025</span>
    </div>
  </section>

  <!-- Page Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <div class="mb-6">
      <Breadcrumbs items={[{ name: "Legal", href: "/privacy" }, { name: "Privacy Policy" }]} />
    </div>

    <!-- Header -->
    <div class="mb-10 sm:mb-14">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">Legal Documentation</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground mb-4">Privacy Policy</h1>
      <p class="text-lg sm:text-xl text-muted-foreground max-w-3xl leading-relaxed">
        At Lupyd, we believe in transparency and protecting your privacy. This policy explains how we collect, use, and safeguard your information.
      </p>
      <p class="text-xs text-muted-foreground mt-3 font-mono sm:hidden">Last updated: October 2025</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
      <!-- Sidebar Table of Contents -->
      <aside class="lg:col-span-1">
        <div class="sticky top-32 space-y-1 p-4 rounded-xl border border-border/50 bg-card/40 backdrop-blur-sm">
          <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3 px-3">Table of Contents</h2>
          <nav id="toc-nav" class="space-y-1">
            {sections.map((section, idx) => (
              <a
                href={`#${section.id}`}
                data-section={section.id}
                class={`toc-link block text-xs sm:text-sm py-2 px-3 rounded-lg transition-all ${
                  idx === 0
                    ? "font-semibold bg-foreground text-background"
                    : "text-muted-foreground hover:text-foreground hover:bg-muted/60"
                }`}
              >
                {section.title}
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Document Content -->
      <main class="lg:col-span-3 space-y-12 text-foreground/90 leading-relaxed">
        <!-- Introduction -->
        <section id="introduction" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Introduction</h2>
          <p>
            Welcome to Lupyd (&ldquo;we,&rdquo; &ldquo;us,&rdquo; &ldquo;our,&rdquo; or &ldquo;Company&rdquo;). Lupyd is committed to protecting your privacy and ensuring you have a positive experience on our platform. This Privacy Policy explains our online information practices and the choices you can make about how your information is collected and used.
          </p>
          <p>
            This Privacy Policy applies to information we collect through our website, mobile application, and all related services (collectively, the &ldquo;Service&rdquo;). Please read this policy carefully. If you do not agree with our policies and practices, please do not use our Service.
          </p>
        </section>

        <!-- Information We Collect -->
        <section id="information-collection" class="scroll-mt-36 space-y-5">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Information We Collect</h2>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Information You Provide Directly</h3>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>Account registration information (name, email, phone number, profile picture)</li>
              <li>Profile information and biographical data</li>
              <li>Content you create, upload, or share (posts, comments, messages)</li>
              <li>Payment and billing information</li>
              <li>Customer support communications</li>
              <li>Preferences and settings</li>
            </ul>
          </div>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Information Collected Automatically</h3>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>Device information (type, operating system, unique identifiers)</li>
              <li>Log data (IP address, access times, pages viewed)</li>
              <li>Location information (with your permission)</li>
              <li>Usage patterns and interaction data</li>
              <li>Cookies and similar tracking technologies</li>
            </ul>
          </div>
        </section>

        <!-- How We Use Your Information -->
        <section id="information-use" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">How We Use Your Information</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30">
            <ul class="list-disc list-inside space-y-2 text-sm sm:text-base text-muted-foreground">
              <li>Providing, maintaining, and improving our Service</li>
              <li>Processing transactions and sending related information</li>
              <li>Sending promotional communications (with your consent)</li>
              <li>Responding to your inquiries and providing customer support</li>
              <li>Personalizing your experience and content recommendations</li>
              <li>Analyzing usage patterns to improve our platform</li>
              <li>Detecting and preventing fraud and security issues</li>
              <li>Complying with legal obligations</li>
            </ul>
          </div>
        </section>

        <!-- Information Sharing -->
        <section id="information-sharing" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Information Sharing</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30">
            <ul class="list-disc list-inside space-y-2.5 text-sm sm:text-base text-muted-foreground">
              <li><strong class="text-foreground">Service Providers:</strong> With vendors who assist us in operating our website and conducting our business</li>
              <li><strong class="text-foreground">Legal Requirements:</strong> When required by law or to protect our rights and safety</li>
              <li><strong class="text-foreground">Business Transfers:</strong> In connection with a merger, acquisition, or sale of assets</li>
              <li><strong class="text-foreground">With Your Consent:</strong> When you explicitly authorize us to share your information</li>
              <li><strong class="text-foreground">Public Content:</strong> Information you choose to make public on your profile</li>
            </ul>
          </div>
        </section>

        <!-- Data Security -->
        <section id="data-security" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Data Security</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <ul class="list-disc list-inside space-y-2 text-sm sm:text-base text-muted-foreground">
              <li>Encryption of data in transit and at rest</li>
              <li>Secure authentication protocols</li>
              <li>Regular security audits and assessments</li>
              <li>Access controls and employee training</li>
              <li>Incident response procedures</li>
            </ul>
            <p class="text-xs sm:text-sm text-muted-foreground pt-2 border-t border-border/30">
              While we strive to protect your information, no security system is impenetrable. We cannot guarantee absolute security of your data.
            </p>
          </div>
        </section>

        <!-- Your Rights -->
        <section id="user-rights" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Your Rights</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30">
            <ul class="list-disc list-inside space-y-2.5 text-sm sm:text-base text-muted-foreground">
              <li><strong class="text-foreground">Right to Access:</strong> Request a copy of your personal information</li>
              <li><strong class="text-foreground">Right to Correction:</strong> Update or correct inaccurate information</li>
              <li><strong class="text-foreground">Right to Deletion:</strong> Request deletion of your data (subject to legal obligations)</li>
              <li><strong class="text-foreground">Right to Opt-Out:</strong> Unsubscribe from marketing communications</li>
              <li><strong class="text-foreground">Right to Data Portability:</strong> Receive your data in a portable format</li>
              <li><strong class="text-foreground">Right to Object:</strong> Object to certain processing activities</li>
            </ul>
          </div>
        </section>

        <!-- Cookies & Tracking Technologies -->
        <section id="cookies" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Cookies &amp; Tracking Technologies</h2>
          <div class="p-5 rounded-xl border border-border/50 bg-card/30">
            <ul class="list-disc list-inside space-y-2 text-sm sm:text-base text-muted-foreground">
              <li><strong class="text-foreground">Essential Cookies:</strong> Required for basic functionality</li>
              <li><strong class="text-foreground">Analytics Cookies:</strong> Help us understand how you use our Service</li>
              <li><strong class="text-foreground">Preference Cookies:</strong> Remember your settings and preferences</li>
              <li><strong class="text-foreground">Marketing Cookies:</strong> Used for targeted advertising (with consent)</li>
            </ul>
          </div>
        </section>

        <!-- Third-Party Services -->
        <section id="third-party" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Third-Party Services</h2>
          <p class="text-muted-foreground">
            Our Service may contain links to third-party websites and services that are not operated by Lupyd. This Privacy Policy does not apply to third-party services, and we are not responsible for their privacy practices. We encourage you to review the privacy policies of any third-party services before providing your information.
          </p>
        </section>

        <!-- Children's Privacy -->
        <section id="children" class="scroll-mt-36 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Children&rsquo;s Privacy</h2>
          <p class="text-muted-foreground">
            Lupyd is not intended for children under the age of 13. We do not knowingly collect personal information from children under 13. If we become aware that we have collected information from a child under 13, we will take steps to delete such information and terminate the child&rsquo;s account.
          </p>
          <p class="text-muted-foreground">
            For users between 13 and 18, we provide additional privacy protections and limit the collection and use of their information.
          </p>
        </section>

        <!-- Child Safety & CSAM Policy -->
        <section id="csam-policy" class="scroll-mt-36 space-y-6 pt-6 border-t border-border/60">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-500 dark:text-red-400 text-xs font-semibold">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Zero-Tolerance Policy
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Child Safety &amp; CSAM Policy</h2>
            <p class="text-muted-foreground">
              Lupyd has a <strong class="text-foreground font-semibold">zero-tolerance policy</strong> for Child Sexual Abuse Material (CSAM) and any content that exploits or endangers children. We are committed to maintaining a safe environment and protecting minors from harm.
            </p>
          </div>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Prohibited Content</h3>
            <p class="text-sm text-muted-foreground">The following activities are strictly prohibited on our platform:</p>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>Uploading, sharing, or distributing any form of CSAM</li>
              <li>Creating, possessing, or transmitting sexually explicit content involving minors</li>
              <li>Grooming, soliciting, or attempting to exploit children</li>
              <li>Sharing content that sexualizes minors in any way</li>
              <li>Facilitating or promoting child exploitation</li>
            </ul>
          </div>

          <div class="p-5 rounded-xl border border-border/50 bg-card/30 space-y-3">
            <h3 class="text-lg font-semibold text-foreground">Our Commitment</h3>
            <p class="text-sm text-muted-foreground">We actively monitor our platform and take immediate action when CSAM or child exploitation is detected:</p>
            <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base text-muted-foreground">
              <li>Immediate removal of all CSAM content</li>
              <li>Permanent account termination for violators</li>
              <li>Reporting to the National Center for Missing &amp; Exploited Children (NCMEC)</li>
              <li>Cooperation with law enforcement agencies worldwide</li>
              <li>Preservation of evidence for legal proceedings</li>
            </ul>
          </div>

          <!-- Alert Reporting Box -->
          <div class="p-5 sm:p-6 rounded-xl border border-red-500/30 bg-red-500/10 dark:bg-red-950/30 space-y-3">
            <h3 class="text-lg font-bold text-red-600 dark:text-red-400">Reporting CSAM</h3>
            <p class="text-sm text-foreground/90">
              If you encounter any content that may constitute CSAM or child exploitation, please report it immediately:
            </p>
            <ul class="space-y-2 text-sm">
              <li class="flex items-center gap-2">
                <span class="font-semibold text-foreground">Email:</span>
                <a href="mailto:complaint@lupyd.com" class="text-red-600 dark:text-red-400 underline hover:opacity-80">
                  complaint@lupyd.com
                </a>
              </li>
              <li class="flex items-center gap-2">
                <span class="font-semibold text-foreground">NCMEC CyberTipline:</span>
                <a
                  href="https://www.cybertipline.org"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-red-600 dark:text-red-400 underline hover:opacity-80"
                >
                  www.cybertipline.org
                </a>
              </li>
            </ul>
          </div>

          <p class="text-sm text-muted-foreground leading-relaxed">
            <strong class="text-foreground">Legal Consequences:</strong> Violations of this policy may result in criminal prosecution. CSAM-related offenses are serious crimes punishable by imprisonment and other severe penalties under federal and international law.
          </p>
        </section>

        <!-- Contact Us -->
        <section id="contact" class="scroll-mt-36 space-y-4 pt-6 border-t border-border/60">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">Contact Us</h2>
          <div class="p-6 rounded-xl border border-border/60 bg-card/40 space-y-4">
            <div>
              <p class="font-bold text-foreground">Lupyd Privacy Team</p>
              <a href="mailto:privacy@lupyd.com" class="text-sm text-primary hover:underline">
                privacy@lupyd.com
              </a>
            </div>
            <div>
              <p class="font-bold text-sm text-foreground">Mailing Address</p>
              <p class="text-sm text-muted-foreground">
                Lupyd<br />
                Khanapuram, Khammam
              </p>
            </div>
            <div>
              <p class="font-bold text-sm text-foreground">Response Time</p>
              <p class="text-sm text-muted-foreground">We aim to respond to all privacy inquiries within 30 days.</p>
            </div>
          </div>
        </section>

        <!-- Footer Notice -->
        <div class="pt-8 border-t border-border/40 text-xs text-muted-foreground leading-relaxed">
          <p>
            This Privacy Policy may be updated from time to time. We will notify you of any material changes by posting the new Privacy Policy on this page and updating the &ldquo;Last updated&rdquo; date. Your continued use of the Service following the posting of revised Privacy Policy means that you accept and agree to the changes.
          </p>
        </div>
      </main>
    </div>
  </div>

  <script>
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section[id]'));

    // IntersectionObserver for TOC highlight
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              const isActive = link.getAttribute('data-section') === id;
              if (isActive) {
                link.classList.remove('text-muted-foreground', 'hover:bg-muted/60');
                link.classList.add('font-semibold', 'bg-foreground', 'text-background');
              } else {
                link.classList.remove('font-semibold', 'bg-foreground', 'text-background');
                link.classList.add('text-muted-foreground', 'hover:bg-muted/60');
              }
            });
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    sections.forEach((section) => observer.observe(section));
  </script>
</Layout>
