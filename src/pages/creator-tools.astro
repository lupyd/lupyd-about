---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Creator Tools - Lupyd" description="Empower your creative journey with Lupyd's comprehensive suite of tools designed for content creators.">

  <!-- ═══════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════ -->
  <section class="ct-hero">
    <div class="ct-hero-bg" aria-hidden="true"><div class="ct-hero-grid"></div></div>

    <div class="ct-container">
      <div class="ct-hero-inner">

        <!-- Left: headline -->
        <div class="ct-hero-left animate-card">
          <span class="ct-pill">Creator Tools</span>
          <h1 class="ct-h1">Create.<br/>Grow.<br/><em>Earn.</em></h1>
        </div>

        <!-- Right: sub + three core tools strip -->
        <div class="ct-hero-right animate-card" style="animation-delay:0.08s">
          <p class="ct-hero-sub">
            Empower your creative journey with Lupyd's comprehensive suite of tools designed for content creators.
          </p>
          <div class="ct-core-strip">
            <div class="ct-core-item">
              <div class="ct-core-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div>
                <p class="ct-core-title">Monetization</p>
                <p class="ct-core-desc">Turn your passion into income.</p>
              </div>
            </div>
            <div class="ct-core-div" aria-hidden="true"></div>
            <div class="ct-core-item">
              <div class="ct-core-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
              <div>
                <p class="ct-core-title">Analytics</p>
                <p class="ct-core-desc">Insights to grow your audience.</p>
              </div>
            </div>
            <div class="ct-core-div" aria-hidden="true"></div>
            <div class="ct-core-item">
              <div class="ct-core-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <div>
                <p class="ct-core-title">Tracking</p>
                <p class="ct-core-desc">Monitor what resonates most.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Full-width product screenshot -->
    <div class="ct-hero-shot animate-card" style="animation-delay:0.18s">
      <div class="ct-container">
        <div class="ct-shot-frame">
          <div class="ct-shot-chrome">
            <span class="ct-chrome-dot"></span>
            <span class="ct-chrome-dot"></span>
            <span class="ct-chrome-dot"></span>
            <span class="ct-chrome-bar">lupyd.com — Creator Dashboard</span>
          </div>
          <img
            src="/screenshots/Screenshot_20260906_114612.webp"
            alt="Lupyd Creator Dashboard"
            class="ct-shot-img"
            loading="eager"
            fetchpriority="high"
            onerror="this.closest('.ct-shot-frame').style.display='none'"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CONTENT CREATION SUITE — editorial split
  ═══════════════════════════════════════════════════════════ -->
  <section class="ct-section ct-section--split">
    <div class="ct-container">
      <div class="ct-split">

        <!-- Text left -->
        <div class="ct-split-text sr">
          <span class="ct-overline">Creation</span>
          <h2 class="ct-split-h2">Content Creation<br/>Suite</h2>
          <p class="ct-split-body">
            Our comprehensive content creation tools help you produce high-quality content that stands out. From ideation to publication, we support your creative process.
          </p>
          <ul class="ct-checklist">
            <li class="ct-check-item">
              <span class="ct-check-mark" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>Simple uploading features</span>
            </li>
            <li class="ct-check-item">
              <span class="ct-check-mark" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>Content inspiration resources</span>
            </li>
            <li class="ct-check-item">
              <span class="ct-check-mark" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>Collaboration features for team projects</span>
            </li>
            <li class="ct-check-item">
              <span class="ct-check-mark" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>AI-powered content suggestions and improvements</span>
            </li>
          </ul>
        </div>

        <!-- Image right -->
        <div class="ct-split-visual sr" style="transition-delay:0.1s">
          <div class="ct-img-frame">
            <img
              src="/CMC.webp"
              alt="Content creation tools"
              class="ct-img-frame-img"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CREATOR TOOLS — inverted band with bento grid
  ═══════════════════════════════════════════════════════════ -->
  <section class="ct-tools-band">
    <div class="ct-container">

      <div class="ct-tools-header sr">
        <span class="ct-tools-overline">Tools</span>
        <h2 class="ct-tools-h2">Creator<br/>Tools</h2>
        <p class="ct-tools-sub">Everything you need to create, publish, and grow.</p>
      </div>

      <!-- Design Tools — full-width editorial showcase ABOVE the bento -->
      <div class="ct-dt-showcase sr">
        <!-- Left: text -->
        <div class="ct-dt-text">
          <div class="ct-dt-top">
            <span class="ct-tool-num">01</span>
          </div>
          <h3 class="ct-dt-heading">Design<br/>Tools</h3>
          <p class="ct-dt-body">Create stunning visuals with our intuitive design tools. Access templates, graphics, and editing features to make your content visually appealing.</p>
        </div>
        <!-- Right: visual composition -->
        <div class="ct-dt-visual" aria-hidden="true">
          <div class="ct-dt-canvas">
            <!-- Palette swatch row -->
            <div class="ct-dt-swatches">
              <span class="ct-dt-swatch ct-dt-swatch--1"></span>
              <span class="ct-dt-swatch ct-dt-swatch--2"></span>
              <span class="ct-dt-swatch ct-dt-swatch--3"></span>
              <span class="ct-dt-swatch ct-dt-swatch--4"></span>
              <span class="ct-dt-swatch ct-dt-swatch--5"></span>
            </div>
            <!-- Mock toolbar -->
            <div class="ct-dt-toolbar">
              <span class="ct-dt-tool-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
              </span>
              <span class="ct-dt-tool-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
              </span>
              <span class="ct-dt-tool-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>
              </span>
              <span class="ct-dt-tool-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </span>
              <span class="ct-dt-tool-btn ct-dt-tool-btn--active">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 13.5V20h6.5L20 8.5 13.5 2 2 13.5z"/><path d="M15 6l3 3"/></svg>
              </span>
            </div>
            <!-- Mock canvas area -->
            <div class="ct-dt-artboard">
              <div class="ct-dt-ab-shape ct-dt-ab-shape--rect"></div>
              <div class="ct-dt-ab-shape ct-dt-ab-shape--circle"></div>
              <div class="ct-dt-ab-shape ct-dt-ab-shape--line"></div>
              <!-- Selection handles -->
              <div class="ct-dt-ab-selection">
                <span class="ct-dt-handle ct-dt-handle--tl"></span>
                <span class="ct-dt-handle ct-dt-handle--tr"></span>
                <span class="ct-dt-handle ct-dt-handle--bl"></span>
                <span class="ct-dt-handle ct-dt-handle--br"></span>
              </div>
            </div>
            <!-- Layers panel -->  
            <div class="ct-dt-layers">
              <p class="ct-dt-layers-label">Layers</p>
              <div class="ct-dt-layer ct-dt-layer--active">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                <span>Background</span>
              </div>
              <div class="ct-dt-layer">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
                <span>Shape 01</span>
              </div>
              <div class="ct-dt-layer">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span>Divider</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="ct-tools-bento sr" style="transition-delay:0.1s">

        <!-- Video Creation -->
        <div class="ct-tool-card">
          <div class="ct-tool-card-top">
            <span class="ct-tool-num">02</span>
            <div class="ct-tool-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            </div>
          </div>
          <h3 class="ct-tool-title">Video Creation</h3>
          <p class="ct-tool-desc">Create high quality videos and increase your engagement with the right audience.</p>
        </div>

        <!-- Content Calendar -->
        <div class="ct-tool-card">
          <div class="ct-tool-card-top">
            <span class="ct-tool-num">03</span>
            <div class="ct-tool-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
          </div>
          <h3 class="ct-tool-title">Content Calendar</h3>
          <p class="ct-tool-desc">Plan and schedule your content with our content calendar. Stay organized and maintain a consistent posting schedule to grow your audience.</p>
        </div>

        <!-- Performance Analytics — full-width bottom -->
        <div class="ct-tool-card ct-tool-card--bottom">
          <div class="ct-tool-bottom-left">
            <div class="ct-tool-card-top">
              <span class="ct-tool-num">04</span>
              <div class="ct-tool-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
            </div>
            <h3 class="ct-tool-title">Performance Analytics</h3>
          </div>
          <p class="ct-tool-desc ct-tool-desc--right">Gain deep insights into your content performance with detailed analytics. Track engagement, reach, and conversion metrics to refine your strategy.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       MONETIZATION OPTIONS — editorial asymmetric layout
  ═══════════════════════════════════════════════════════════ -->
  <section class="ct-section ct-section--mono">
    <div class="ct-container">

      <div class="ct-mono-header sr">
        <span class="ct-overline">Monetization</span>
        <h2 class="ct-mono-h2">Monetization<br/>Options</h2>
      </div>

      <div class="ct-mono-grid sr" style="transition-delay:0.08s">

        <!-- Creator Fund — featured wide -->
        <div class="ct-mono-card ct-mono-card--featured">
          <div class="ct-mono-card-top">
            <span class="ct-mono-num">01</span>
            <div class="ct-mono-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
          </div>
          <h3 class="ct-mono-title">
            Creator Fund
            <span class="ct-soon-badge">soon</span>
          </h3>
          <p class="ct-mono-desc">Access our Creator Fund to receive financial support based on your content performance and audience engagement. Reward your creativity and hard work.</p>
        </div>

        <!-- Subscription Model -->
        <div class="ct-mono-card">
          <div class="ct-mono-card-top">
            <span class="ct-mono-num">02</span>
            <div class="ct-mono-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
            </div>
          </div>
          <h3 class="ct-mono-title">Subscription Model</h3>
          <p class="ct-mono-desc">Offer premium content to subscribers who pay a monthly fee. Build a steady income stream while providing exclusive value to your most dedicated followers.</p>
        </div>

        <!-- Brand Partnerships -->
        <div class="ct-mono-card">
          <div class="ct-mono-card-top">
            <span class="ct-mono-num">03</span>
            <div class="ct-mono-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
          </div>
          <h3 class="ct-mono-title">Brand Partnerships</h3>
          <p class="ct-mono-desc">Connect with brands for sponsored content opportunities. Our platform makes it easy to find and collaborate with brands that align with your values.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       CLOSING CTA
  ═══════════════════════════════════════════════════════════ -->
  <section class="ct-cta sr">
    <div class="ct-container">
      <div class="ct-cta-inner">
        <span class="ct-overline">Get started</span>
        <h2 class="ct-cta-h2">Your creative<br/>journey starts here.</h2>
        <a href="/" class="ct-cta-btn">← Back to Home</a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── SHARED ──────────────────────────────────────────────────── */
.ct-container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.ct-overline {
  display: block;
  font-size: 0.63rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: hsl(var(--muted-foreground));
  margin-bottom: 0.8rem;
}

.ct-pill {
  display: inline-flex;
  align-items: center;
  border: 1px solid hsl(var(--border));
  border-radius: 999px;
  padding: 3px 13px;
  font-size: 0.63rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: hsl(var(--muted-foreground));
  margin-bottom: 1.75rem;
}

/* ── HERO ────────────────────────────────────────────────────── */
.ct-hero {
  position: relative;
  overflow: hidden;
  padding: 5rem 0 0;
  border-bottom: 1px solid hsl(var(--border));
}

.ct-hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.ct-hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(hsl(var(--border) / 0.5) 1px, transparent 1px),
    linear-gradient(90deg, hsl(var(--border) / 0.5) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 85% 65% at 50% 0%, black 30%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 85% 65% at 50% 0%, black 30%, transparent 100%);
}

.ct-hero-inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: end;
  padding-bottom: 3.5rem;
}

.ct-hero-left { display: flex; flex-direction: column; }

.ct-h1 {
  font-size: clamp(3.4rem, 8.5vw, 7rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 0.92;
  color: hsl(var(--foreground));
  margin: 0;
}

.ct-h1 em {
  font-style: italic;
  font-weight: 300;
  letter-spacing: -0.03em;
}

.ct-hero-right {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  align-self: end;
  padding-bottom: 0.5rem;
}

.ct-hero-sub {
  font-size: clamp(0.88rem, 1.6vw, 1rem);
  color: hsl(var(--muted-foreground));
  line-height: 1.72;
  max-width: 380px;
  margin: 0;
}

/* Core strip */
.ct-core-strip {
  display: flex;
  flex-direction: column;
  border: 1px solid hsl(var(--border));
  border-radius: 10px;
  overflow: hidden;
  background: hsl(var(--card));
}

.ct-core-item {
  display: flex;
  align-items: flex-start;
  gap: 0.9rem;
  padding: 1.1rem 1.4rem;
  border-bottom: 1px solid hsl(var(--border));
  transition: background 0.2s;
}

.ct-core-item:last-child { border-bottom: none; }
.ct-core-item:hover { background: hsl(var(--muted) / 0.5); }

.ct-core-div { display: none; }

.ct-core-icon {
  width: 32px; height: 32px;
  border-radius: 7px;
  border: 1px solid hsl(var(--border));
  background: hsl(var(--background));
  display: flex;
  align-items: center;
  justify-content: center;
  color: hsl(var(--foreground));
  flex-shrink: 0;
  margin-top: 1px;
  transition: transform 0.2s, border-color 0.2s;
}

.ct-core-item:hover .ct-core-icon {
  transform: translateY(-2px);
  border-color: hsl(var(--foreground) / 0.3);
}

.ct-core-title {
  font-size: 0.82rem;
  font-weight: 700;
  color: hsl(var(--foreground));
  letter-spacing: -0.01em;
  margin: 0 0 0.2rem;
}

.ct-core-desc {
  font-size: 0.72rem;
  color: hsl(var(--muted-foreground));
  line-height: 1.55;
  margin: 0;
}

/* Hero screenshot */
.ct-hero-shot { position: relative; z-index: 1; }

.ct-shot-frame {
  width: 100%;
  border-radius: 10px 10px 0 0;
  border: 1px solid hsl(var(--border));
  border-bottom: none;
  overflow: hidden;
  background: hsl(var(--card));
  box-shadow: 0 0 0 1px hsl(var(--border) / 0.4), 0 -4px 40px -8px rgba(0,0,0,0.08);
}

.dark .ct-shot-frame {
  box-shadow: 0 0 0 1px hsl(var(--border) / 0.4), 0 -4px 40px -8px rgba(0,0,0,0.5);
}

.ct-shot-chrome {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 8px 12px;
  background: hsl(var(--muted));
  border-bottom: 1px solid hsl(var(--border));
}

.ct-chrome-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: hsl(var(--border));
}

.ct-chrome-bar {
  flex: 1;
  max-width: 220px;
  height: 15px;
  border-radius: 4px;
  background: hsl(var(--border) / 0.5);
  margin-left: 6px;
  font-size: 9px;
  color: hsl(var(--muted-foreground));
  display: flex;
  align-items: center;
  padding: 0 7px;
}

