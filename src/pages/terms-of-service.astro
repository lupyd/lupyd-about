---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Terms of Service - Lupyd"
  description="Please read these terms carefully before using Lupyd. By accessing or using our platform, you agree to be bound by these Terms of Service."
>
  <!-- Legal Sub-nav Tabs -->
  <section class="border-b border-border/50 bg-background/60 backdrop-blur-md sticky top-16 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2 sm:gap-6 overflow-x-auto no-scrollbar py-1">
        <a
          href="/privacy"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-of-use"
          class="text-xs sm:text-sm font-medium px-3 py-1.5 rounded-full text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors whitespace-nowrap"
        >
          Terms of Use
        </a>
        <a
          href="/terms-of-service"
          class="text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-full bg-foreground text-background transition-colors whitespace-nowrap"
        >
          Terms of Service
        </a>
      </div>
      <span class="hidden sm:inline-block text-xs text-muted-foreground font-mono">Last updated: Oct 2025</span>
    </div>
  </section>

  <!-- Page Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Header -->
    <div class="mb-10 sm:mb-12">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">Legal Agreement</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground mb-4">Terms of Service</h1>
      <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed">
        Please read these terms carefully before using Lupyd.
      </p>
      <p class="text-xs text-muted-foreground mt-3 font-mono">Last updated: October 2025</p>
    </div>

    <!-- Main Content -->
    <main class="space-y-8 text-foreground/90 leading-relaxed">
      <div class="p-6 rounded-xl border border-border/50 bg-card/40 backdrop-blur-sm">
        <p class="text-base sm:text-lg leading-relaxed">
          Welcome to <strong class="text-foreground font-semibold">Lupyd</strong>. By accessing or using our platform, you agree to be bound by these Terms of Service. Please read them carefully before using any Lupyd service or feature.
        </p>
      </div>

      <div class="space-y-6">
        <!-- 1. Acceptance of Terms -->
        <section class="p-6 rounded-xl border border-border/50 bg-card/30 space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">1. Acceptance of Terms</h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
            By registering, accessing, or using Lupyd, you confirm that you accept these terms. If you do not agree, you may not use our services.
          </p>
        </section>

        <!-- 2. User Responsibilities -->
        <section class="p-6 rounded-xl border border-border/50 bg-card/30 space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">2. User Responsibilities</h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
            You agree to use Lupyd responsibly, without violating any applicable laws. You must not misuse, hack, or attempt unauthorized access to any part of our platform.
          </p>
        </section>

        <!-- 3. Privacy & Data -->
        <section class="p-6 rounded-xl border border-border/50 bg-card/30 space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">3. Privacy &amp; Data</h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
            Your privacy is important to us. All data collected is handled securely and in accordance with our{" "}
            <a href="/privacy" class="text-foreground underline underline-offset-4 hover:text-primary transition-colors font-medium">
              Privacy Policy
            </a>.
          </p>
        </section>

        <!-- 4. Limitation of Liability -->
        <section class="p-6 rounded-xl border border-border/50 bg-card/30 space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">4. Limitation of Liability</h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
            Lupyd is not liable for any indirect, incidental, or consequential damages resulting from the use or inability to use our services.
          </p>
        </section>

        <!-- 5. Updates to Terms -->
        <section class="p-6 rounded-xl border border-border/50 bg-card/30 space-y-3">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-foreground">5. Updates to Terms</h2>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed">
            Lupyd may modify these Terms of Service from time to time. Continued use of our platform means you accept the updated terms.
          </p>
        </section>
      </div>

      <div class="pt-8 border-t border-border/40 text-xs text-muted-foreground italic">
        Last updated: October 2025
      </div>
    </main>
  </div>
</Layout>
