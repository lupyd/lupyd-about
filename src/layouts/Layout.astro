---
import "../styles/global.css";
import ColorBends from "../components/ColorBends.astro";

export interface BreadcrumbItem {
  name: string;
  href?: string;
}

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  pageType?: "WebPage" | "AboutPage" | "FAQPage" | "ItemPage" | "ContactPage";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const { 
  title = "Lupyd : Private by design. Connected by default.", 
  description = "The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption, not bolted on as an afterthought.",
  image = "/screenshots-bg.webp",
  imageAlt = "Lupyd - Private by design. Connected by default.",
  type = "website",
  pageType = "WebPage",
  publishedTime,
  modifiedTime,
  noindex = false,
  breadcrumbs,
  schema
} = Astro.props;

// Current path for active link highlight and canonical URL
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.endsWith('/') && currentPath.length > 1 ? currentPath.slice(0, -1) : currentPath;

// Dynamic site origin from Astro.site (fallback to https://www.lupyd.com)
const siteUrl = (Astro.site ? new URL(Astro.site).origin : "https://www.lupyd.com").replace(/\/$/, "");
const canonicalURL = new URL(cleanPath === "" ? "/" : cleanPath, siteUrl).href;
const ogImageURL = image.startsWith("http") ? image : new URL(image, siteUrl).href;

// ── SCHEMA.ORG JSON-LD GRAPH GENERATION ──────────────────────
const organizationSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "Lupyd",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/favicon.png`,
    "width": 1024,
    "height": 1024
  },
  "description": "The workspace where nothing leaks. Private by design, connected by default.",
  "sameAs": [
    "https://github.com/lupyd-foundation"
  ]
};

const webSiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Lupyd",
  "description": "Private collaborative platform with end-to-end encryption.",
  "publisher": { "@id": `${siteUrl}/#organization` },
  "inLanguage": "en-US"
};

const webPageSchema: Record<string, any> = {
  "@type": pageType,
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": { "@id": `${siteUrl}/#website` },
  "inLanguage": "en-US"
};

if (publishedTime) webPageSchema["datePublished"] = publishedTime;
if (modifiedTime) webPageSchema["dateModified"] = modifiedTime;

// BreadcrumbList Schema
let breadcrumbSchema: Record<string, any> | null = null;
if (breadcrumbs && breadcrumbs.length > 0) {
  breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      ...breadcrumbs.map((b, i) => {
        const itemUrl = b.href
          ? (b.href.startsWith("http") ? b.href : new URL(b.href, siteUrl).href)
          : canonicalURL;
        return {
          "@type": "ListItem",
          "position": i + 2,
          "name": b.name,
          "item": itemUrl
        };
      })
    ]
  };
}

// Assemble full JSON-LD @graph
const schemaGraph: any[] = [organizationSchema, webSiteSchema, webPageSchema];
if (breadcrumbSchema) {
  schemaGraph.push(breadcrumbSchema);
}
if (schema) {
  if (Array.isArray(schema)) {
    schemaGraph.push(...schema);
  } else {
    schemaGraph.push(schema);
  }
}

const fullJsonLd = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};

const navLinks = [
  { href: "/features", label: "Features", external: false },
  { href: "https://billing.lupyd.com", label: "Pricing", external: true },
  { href: "/roadmap", label: "Roadmap", external: false },
  { href: "/faq", label: "FAQ", external: false },
  { href: "https://blogs.lupyd.com", label: "Blogs", external: true },
  { href: "https://docs.lupyd.com", label: "Documentation", external: true }
];
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="msvalidate.01" content="F6C001C6132A22D214ECCE7E3759F4B5" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Lupyd" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="559" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:image:alt" content={imageAlt} />

    <!-- Schema.org Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(fullJsonLd)} />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
    
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen flex flex-col antialiased">
    <!-- Optimized WebGL fabric-like background -->
    <div class="fixed inset-0 -z-10 pointer-events-none opacity-[0.28] dark:opacity-[0.16]">
      <ColorBends
        colors={["#333333", "#666666", "#999999"]}
        rotation={35}
        speed={0.12}
        scale={1.2}
        frequency={1.5}
        warpStrength={1.1}
        noise={0.03}
        transparent={true}
      />
    </div>

    <header class="sticky top-0 z-40 border-b border-border/40 bg-background/80 backdrop-blur-md">
      <div class="container mx-auto flex h-16 items-center justify-between px-4 py-4 max-w-7xl">
        <div class="flex items-center gap-2">
          <a href="/" class="text-xl font-bold tracking-tight hover:opacity-85 transition-opacity" id="logo-link">
            <span>Lupyd</span>
          </a>
        </div>
        
        <nav class="hidden md:flex gap-4 lg:gap-6">
          {navLinks.map(({ href, label, external }) => {
            const isActive = cleanPath === href;
            return (
              <a 
                href={href} 
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class={`text-sm font-medium transition-colors hover:text-foreground/80 ${isActive ? 'text-foreground border-b-2 border-foreground pb-1' : 'text-muted-foreground'}`}
              >
                {label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2 md:gap-4">
          <!-- Theme toggle button -->
          <button
            id="theme-toggle"
            class="p-2 rounded-md hover:bg-muted/80 text-foreground transition-colors cursor-pointer"
            aria-label="Toggle theme"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg
              id="sun-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden dark:block"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg
              id="moon-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="block dark:hidden"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>

          <!-- Mobile menu button -->
          <button
            class="md:hidden p-2 relative z-50 rounded-md hover:bg-muted/80 text-foreground transition-colors"
            id="mobile-menu-btn"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-200"
              id="menu-icon"
            >
              <path class="line-1" d="M3 12h18" />
              <path class="line-2" d="M3 6h18" />
              <path class="line-3" d="M3 18h18" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden fixed inset-0 z-40 md:hidden">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="mobile-menu-backdrop"></div>

        <!-- Dropdown Content -->
        <div class="absolute top-16 left-0 right-0 bg-background border-b border-border shadow-lg z-50">
          <div class="container mx-auto py-6 px-4 flex flex-col space-y-4">
            {navLinks.map(({ href, label, external }) => {
              const isActive = cleanPath === href;
              return (
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class={`text-sm font-medium py-3 px-4 rounded-md transition-colors hover:bg-muted ${isActive ? 'bg-muted text-foreground font-semibold' : 'text-muted-foreground'}`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 flex flex-col relative z-10">
      <slot />
    </main>

    <footer class="border-t border-border/40 bg-background/50 backdrop-blur-sm py-10 md:py-16 mt-auto">
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="flex flex-col md:flex-row justify-between items-start gap-8">
          <div class="space-y-4 max-w-md">
            <a href="/" class="text-xl font-bold tracking-tight">Lupyd</a>
            <p class="text-sm text-muted-foreground">
              The workspace where nothing leaks. Private by design, connected by default.
            </p>
            <!-- Global Status Notice -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-muted/60 border border-border/60 text-muted-foreground">
              <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
              <span>New updates will come soon</span>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-8 sm:gap-12 lg:gap-16">
            <div class="space-y-3">
              <h4 class="text-sm font-semibold tracking-wider uppercase text-foreground">Platform</h4>
              <ul class="space-y-2">
                <li><a href="/faq" class="text-sm text-muted-foreground hover:text-foreground transition-colors">FAQ</a></li>
                <li><a href="/support" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Support</a></li>
                <li><a href="https://billing.lupyd.com" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Pricing</a></li>
                <li><a href="https://docs.lupyd.com" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Documentation</a></li>
              </ul>
            </div>
            <div class="space-y-3">
              <h4 class="text-sm font-semibold tracking-wider uppercase text-foreground">Community</h4>
              <ul class="space-y-2">
                <li><a href="https://blogs.lupyd.com" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Blogs</a></li>
                <li><a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Privacy</a></li>
                <li><a href="/terms-of-use" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Use</a></li>
                <li><a href="/terms-of-service" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Service</a></li>
              </ul>
            </div>
            <div class="space-y-3">
              <h4 class="text-sm font-semibold tracking-wider uppercase text-foreground">Connect</h4>
              <ul class="space-y-2">
                <li><a href="https://threads.net/@lupyd" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2">Threads</a></li>
                <li><a href="https://youtube.com/@lupyd" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2">YouTube</a></li>
                <li><a href="https://x.com/lupyd" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2">Twitter / X</a></li>
                <li><a href="https://instagram.com/lupyd" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2">Instagram</a></li>
                <li><a href="https://whatsapp.com/channel/lupyd" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2">WhatsApp</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-8 border-t border-border/20 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-xs text-muted-foreground">
            &copy; {new Date().getFullYear()} Lupyd. Developed with focus on security.
          </p>
          <div class="flex items-center gap-2 text-muted-foreground">
            <!-- Threads -->
            <a
              href="https://threads.net/@lupyd"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-full hover:bg-muted hover:text-foreground transition-colors"
              aria-label="Threads"
              title="Threads"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M12.186 24h-.007c-3.581-.024-6.334-1.222-8.184-3.563C2.26 18.204 1.5 15.308 1.5 11.956 1.5 8.48 2.37 5.568 4.088 3.279 5.894.873 8.653 0 12.296 0c3.701 0 6.452.923 8.176 2.744 1.579 1.666 2.4 4.07 2.44 7.145l-2.613.11c-.033-2.457-.655-4.25-1.848-5.328-1.242-1.12-3.327-1.688-6.195-1.688-2.88 0-5.02.63-6.36 1.875C4.42 6.223 3.7 8.74 3.7 11.956c0 2.89.58 5.24 1.724 6.985 1.272 1.94 3.32 2.924 6.088 2.924 3.376 0 5.434-1.066 6.115-3.167.31-.956.444-2.148.444-3.921H12.24v-2.585h8.318v1.393c0 2.217-.184 3.967-.55 5.203-1.082 3.655-4.047 5.215-7.822 5.215z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href="https://youtube.com/@lupyd"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-full hover:bg-muted hover:text-foreground transition-colors"
              aria-label="YouTube"
              title="YouTube"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- Twitter / X -->
            <a
              href="https://x.com/lupyd"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-full hover:bg-muted hover:text-foreground transition-colors"
              aria-label="Twitter / X"
              title="Twitter / X"
            >
              <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href="https://instagram.com/lupyd"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-full hover:bg-muted hover:text-foreground transition-colors"
              aria-label="Instagram"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>

            <!-- WhatsApp -->
            <a
              href="https://whatsapp.com/channel/lupyd"
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-full hover:bg-muted hover:text-foreground transition-colors"
              aria-label="WhatsApp"
              title="WhatsApp"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Theme Toggle Handler
      const themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const element = document.documentElement;
          element.classList.toggle('dark');
          const isDark = element.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }


      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-menu-backdrop');
      const menuIcon = document.getElementById('menu-icon');

      if (mobileMenuBtn && mobileMenu && backdrop && menuIcon) {
        let isOpen = false;

        const toggleMenu = () => {
          isOpen = !isOpen;
          mobileMenuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          
          if (isOpen) {
            mobileMenu.classList.remove('hidden');
            // Change hamburger to X
            menuIcon.innerHTML = '<path class="line-1" d="M18 6L6 18M6 6l12 12" />';
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu.classList.add('hidden');
            // Change back to hamburger
            menuIcon.innerHTML = '<path class="line-1" d="M3 12h18" /><path class="line-2" d="M3 6h18" /><path class="line-3" d="M3 18h18" />';
            document.body.style.overflow = '';
          }
        };

        mobileMenuBtn.addEventListener('click', toggleMenu);
        backdrop.addEventListener('click', toggleMenu);

        // Clean up on navigate
        document.addEventListener('astro:before-swap', () => {
          isOpen = false;
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        });
      }
    </script>
  </body>
</html>
