---
import "../styles/global.css";
import ColorBends from "../components/ColorBends.astro";

export interface BreadcrumbItem {
  name: string;
  href?: string;
}

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  pageType?: "WebPage" | "AboutPage" | "FAQPage" | "ItemPage" | "ContactPage";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const { 
  title = "Lupyd : Private by design. Connected by default.", 
  description = "The workspace where nothing leaks. Organize conversations into channels, message your team in real time, and stay updated — all protected with end-to-end encryption, not bolted on as an afterthought.",
  image = "/screenshots-bg.webp",
  imageAlt = "Lupyd - Private by design. Connected by default.",
  type = "website",
  pageType = "WebPage",
  publishedTime,
  modifiedTime,
  noindex = false,
  breadcrumbs,
  schema
} = Astro.props;

// Current path for active link highlight and canonical URL
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.endsWith('/') && currentPath.length > 1 ? currentPath.slice(0, -1) : currentPath;

// Dynamic site origin from Astro.site (fallback to https://www.lupyd.com)
const siteUrl = (Astro.site ? new URL(Astro.site).origin : "https://www.lupyd.com").replace(/\/$/, "");
const canonicalURL = new URL(cleanPath === "" ? "/" : cleanPath, siteUrl).href;
const ogImageURL = image.startsWith("http") ? image : new URL(image, siteUrl).href;

// ── SCHEMA.ORG JSON-LD GRAPH GENERATION ──────────────────────
const organizationSchema = {
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": "Lupyd",
  "url": siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteUrl}/favicon.png`,
    "width": 1024,
    "height": 1024
  },
  "description": "The workspace where nothing leaks. Private by design, connected by default.",
  "sameAs": [
    "https://github.com/lupyd-foundation"
  ]
};

const webSiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Lupyd",
  "description": "Private collaborative platform with end-to-end encryption.",
  "publisher": { "@id": `${siteUrl}/#organization` },
  "inLanguage": "en-US"
};

const webPageSchema: Record<string, any> = {
  "@type": pageType,
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": { "@id": `${siteUrl}/#website` },
  "inLanguage": "en-US"
};

if (publishedTime) webPageSchema["datePublished"] = publishedTime;
if (modifiedTime) webPageSchema["dateModified"] = modifiedTime;

// BreadcrumbList Schema
let breadcrumbSchema: Record<string, any> | null = null;
if (breadcrumbs && breadcrumbs.length > 0) {
  breadcrumbSchema = {
    "@type": "BreadcrumbList",
    "@id": `${canonicalURL}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      ...breadcrumbs.map((b, i) => {
        const itemUrl = b.href
          ? (b.href.startsWith("http") ? b.href : new URL(b.href, siteUrl).href)
          : canonicalURL;
        return {
          "@type": "ListItem",
          "position": i + 2,
          "name": b.name,
          "item": itemUrl
        };
      })
    ]
  };
}

// Assemble full JSON-LD @graph
const schemaGraph: any[] = [organizationSchema, webSiteSchema, webPageSchema];
if (breadcrumbSchema) {
  schemaGraph.push(breadcrumbSchema);
}
if (schema) {
  if (Array.isArray(schema)) {
    schemaGraph.push(...schema);
  } else {
    schemaGraph.push(schema);
  }
}

const fullJsonLd = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};

const navLinks = [
  { href: "https://billing.lupyd.com", label: "Pricing", external: true },
  { href: "/faq", label: "FAQ", external: false },
  { href: "https://blogs.lupyd.com", label: "Blogs", external: true },
  { href: "https://docs.lupyd.com", label: "Documentation", external: true }
];
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="msvalidate.01" content="F6C001C6132A22D214ECCE7E3759F4B5" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Lupyd" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="559" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:image:alt" content={imageAlt} />

    <!-- Schema.org Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(fullJsonLd)} />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
    
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-background text-foreground min-h-screen flex flex-col antialiased">
    <!-- Optimized WebGL fabric-like background -->
    <div class="fixed inset-0 -z-10 pointer-events-none opacity-[0.28] dark:opacity-[0.16]">
      <ColorBends
        colors={["#333333", "#666666", "#999999"]}
        rotation={35}
        speed={0.12}
        scale={1.2}
        frequency={1.5}
        warpStrength={1.1}
        noise={0.03}
        transparent={true}
      />
    </div>

    <header class="sticky top-0 z-40 border-b border-border/40 bg-background/80 backdrop-blur-md">
      <div class="container mx-auto flex h-16 items-center justify-between px-4 py-4 max-w-7xl">
        <div class="flex items-center gap-2">
          <a href="/" class="text-xl font-bold tracking-tight hover:opacity-85 transition-opacity" id="logo-link">
            <span>Lupyd</span>
          </a>
        </div>
        
        <nav class="hidden md:flex gap-4 lg:gap-6">
          {navLinks.map(({ href, label, external }) => {
            const isActive = cleanPath === href;
            return (
              <a 
                href={href} 
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class={`text-sm font-medium transition-colors hover:text-foreground/80 ${isActive ? 'text-foreground border-b-2 border-foreground pb-1' : 'text-muted-foreground'}`}
              >
                {label}
              </a>
            );
          })}
        </nav>

        <div class="flex items-center gap-2 md:gap-4">
          <!-- Theme toggle button -->
          <button
            id="theme-toggle"
            class="p-2 rounded-md hover:bg-muted/80 text-foreground transition-colors cursor-pointer"
            aria-label="Toggle theme"
          >
            <!-- Sun icon (shown in dark mode) -->
            <svg
              id="sun-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hidden dark:block"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <!-- Moon icon (shown in light mode) -->
            <svg
              id="moon-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="block dark:hidden"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>

          <!-- Mobile menu button -->
          <button
            class="md:hidden p-2 relative z-50 rounded-md hover:bg-muted/80 text-foreground transition-colors"
            id="mobile-menu-btn"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-200"
              id="menu-icon"
            >
              <path class="line-1" d="M3 12h18" />
              <path class="line-2" d="M3 6h18" />
              <path class="line-3" d="M3 18h18" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden fixed inset-0 z-40 md:hidden">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="mobile-menu-backdrop"></div>

        <!-- Dropdown Content -->
        <div class="absolute top-16 left-0 right-0 bg-background border-b border-border shadow-lg z-50">
          <div class="container mx-auto py-6 px-4 flex flex-col space-y-4">
            {navLinks.map(({ href, label, external }) => {
              const isActive = cleanPath === href;
              return (
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class={`text-sm font-medium py-3 px-4 rounded-md transition-colors hover:bg-muted ${isActive ? 'bg-muted text-foreground font-semibold' : 'text-muted-foreground'}`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 flex flex-col relative z-10">
      <slot />
    </main>

    <footer class="border-t border-border/40 bg-background/50 backdrop-blur-sm py-10 md:py-16 mt-auto">
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="flex flex-col md:flex-row justify-between items-start gap-8">
          <div class="space-y-4 max-w-md">
            <a href="/" class="text-xl font-bold tracking-tight">Lupyd</a>
            <p class="text-sm text-muted-foreground">
              The workspace where nothing leaks. Private by design, connected by default.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-8 sm:gap-16">
            <div class="space-y-3">
              <h4 class="text-sm font-semibold tracking-wider uppercase text-foreground">Platform</h4>
              <ul class="space-y-2">
                <li><a href="/faq" class="text-sm text-muted-foreground hover:text-foreground transition-colors">FAQ</a></li>
                <li><a href="/support" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Support</a></li>
                <li><a href="https://billing.lupyd.com" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Pricing</a></li>
                <li><a href="https://docs.lupyd.com" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Documentation</a></li>
              </ul>
            </div>
            <div class="space-y-3">
              <h4 class="text-sm font-semibold tracking-wider uppercase text-foreground">Community</h4>
              <ul class="space-y-2">
                <li><a href="https://blogs.lupyd.com" target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Blogs</a></li>
                <li><a href="/privacy" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Privacy</a></li>
                <li><a href="/terms-of-use" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Use</a></li>
                <li><a href="/terms-of-service" class="text-sm text-muted-foreground hover:text-foreground transition-colors">Terms of Service</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-border/20 flex flex-col sm:flex-row justify-between items-center gap-4">
          <p class="text-xs text-muted-foreground">
            &copy; {new Date().getFullYear()} Lupyd. Developed with focus on security.
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Theme Toggle Handler
      const themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const element = document.documentElement;
          element.classList.toggle('dark');
          const isDark = element.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }


      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-menu-backdrop');
      const menuIcon = document.getElementById('menu-icon');

      if (mobileMenuBtn && mobileMenu && backdrop && menuIcon) {
        let isOpen = false;

        const toggleMenu = () => {
          isOpen = !isOpen;
          mobileMenuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          
          if (isOpen) {
            mobileMenu.classList.remove('hidden');
            // Change hamburger to X
            menuIcon.innerHTML = '<path class="line-1" d="M18 6L6 18M6 6l12 12" />';
            document.body.style.overflow = 'hidden';
          } else {
            mobileMenu.classList.add('hidden');
            // Change back to hamburger
            menuIcon.innerHTML = '<path class="line-1" d="M3 12h18" /><path class="line-2" d="M3 6h18" /><path class="line-3" d="M3 18h18" />';
            document.body.style.overflow = '';
          }
        };

        mobileMenuBtn.addEventListener('click', toggleMenu);
        backdrop.addEventListener('click', toggleMenu);

        // Clean up on navigate
        document.addEventListener('astro:before-swap', () => {
          isOpen = false;
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        });
      }
    </script>
  </body>
</html>
