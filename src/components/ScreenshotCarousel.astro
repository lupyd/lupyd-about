---
// Screenshot Carousel Component - Alternating Light & Dark Mode
interface Slide {
  id: string;
  src: string;
  alt: string;
  title: string;
  category: string;
  mode: 'light' | 'dark';
}

const slides: Slide[] = [
  {
    id: "slide-1",
    src: "/screenshots/Screenshot_20260906_065353.webp",
    alt: "Lupyd Platform Interface - Direct Messaging & Communication (Light Mode)",
    title: "Secure Communication & Chat",
    category: "Messaging",
    mode: "light"
  },
  {
    id: "slide-2",
    src: "/screenshots/Screenshot_20260906_114410.webp",
    alt: "Lupyd Platform Interface - Direct Messaging & Communication (Dark Mode)",
    title: "Secure Communication & Chat",
    category: "Messaging",
    mode: "dark"
  },
  {
    id: "slide-3",
    src: "/screenshots/Screenshot_20260906_065426.webp",
    alt: "Lupyd Workspace & Project Collaboration (Light Mode)",
    title: "Real-Time Collaboration Canvas",
    category: "Workspace",
    mode: "light"
  },
  {
    id: "slide-4",
    src: "/screenshots/Screenshot_20260906_114449.webp",
    alt: "Lupyd Workspace & Project Collaboration (Dark Mode)",
    title: "Real-Time Collaboration Canvas",
    category: "Workspace",
    mode: "dark"
  },
  {
    id: "slide-5",
    src: "/screenshots/Screenshot_20260906_065648.webp",
    alt: "Lupyd Social Feed & Activity Stream (Light Mode)",
    title: "Interactive Social Feed & Updates",
    category: "Social Network",
    mode: "light"
  },
  {
    id: "slide-6",
    src: "/screenshots/Screenshot_20260906_114612.webp",
    alt: "Lupyd Social Feed & Activity Stream (Dark Mode)",
    title: "Interactive Social Feed & Updates",
    category: "Social Network",
    mode: "dark"
  },
  {
    id: "slide-7",
    src: "/screenshots/Screenshot_20260906_065759.webp",
    alt: "Lupyd Analytics & Insights Dashboard (Light Mode)",
    title: "Analytics & Growth Dashboard",
    category: "Insights",
    mode: "light"
  },
  {
    id: "slide-8",
    src: "/screenshots/Screenshot_20260906_114639.webp",
    alt: "Lupyd Analytics & Insights Dashboard (Dark Mode)",
    title: "Analytics & Growth Dashboard",
    category: "Insights",
    mode: "dark"
  },
  {
    id: "slide-9",
    src: "/screenshots/Screenshot_20260906_065907.webp",
    alt: "Lupyd Media Manager & Content Sharing (Light Mode)",
    title: "Multi-Format Media Manager",
    category: "Media Library",
    mode: "light"
  },
  {
    id: "slide-10",
    src: "/screenshots/Screenshot_20260906_114657.webp",
    alt: "Lupyd Media Manager & Content Sharing (Dark Mode)",
    title: "Multi-Format Media Manager",
    category: "Media Library",
    mode: "dark"
  },
  {
    id: "slide-11",
    src: "/screenshots/Screenshot_20260906_070005.webp",
    alt: "Lupyd Privacy & Security Settings (Light Mode)",
    title: "Zero-Knowledge Security Controls",
    category: "Privacy & Security",
    mode: "light"
  },
  {
    id: "slide-12",
    src: "/screenshots/Screenshot_20260906_114725.webp",
    alt: "Lupyd Privacy & Security Settings (Dark Mode)",
    title: "Zero-Knowledge Security Controls",
    category: "Privacy & Security",
    mode: "dark"
  },
  {
    id: "slide-13",
    src: "/screenshots/Screenshot_20260906_114318.webp",
