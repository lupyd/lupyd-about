---
interface Props {
  desktopSrc?: string;
  desktopAlt?: string;
  mobileSrc?: string;
  mobileAlt?: string;
  class?: string;
}

const {
  desktopSrc = "/screenshots/desktop/group-channel-dark.webp",
  desktopAlt = "Lupyd Desktop Application",
  mobileSrc = "/screenshots/mobile/group-channel-dark.webp",
  mobileAlt = "Lupyd Mobile Application",
  class: className = ""
} = Astro.props;

const desktopDark = desktopSrc.includes('-dark') ? desktopSrc : desktopSrc.replace('.webp', '-dark.webp');
const desktopLight = desktopSrc.replace('-dark.webp', '.webp');

const mobileDark = mobileSrc.includes('-dark') ? mobileSrc : mobileSrc.replace('.webp', '-dark.webp');
const mobileLight = mobileSrc.replace('-dark.webp', '.webp');

const getDesktopSrcset = (src: string) => {
  const base = src.replace(/\.webp$/, '');
  return `${base}-640.webp 640w, ${base}-1024.webp 1024w, ${src} 1440w`;
};

const getMobileSrcset = (src: string) => {
  const base = src.replace(/\.webp$/, '');
  return `${base}-360.webp 360w, ${base}-540.webp 540w, ${src} 780w`;
};
---

<div class={`relative w-full max-w-5xl mx-auto select-none ${className}`}>
  <!-- Laptop Container -->
  <div class="relative w-full aspect-[4256/2834]">
    <!-- Ambient glow behind laptop -->
    <div 
      class="absolute inset-x-12 top-10 bottom-16 bg-neutral-900/30 blur-3xl rounded-full pointer-events-none -z-10" 
      aria-hidden="true"
    ></div>

    <!-- Desktop Screen Cutout Area (sitting beneath the bezel) -->
    <div
      class="absolute overflow-hidden bg-[#0c0d0e] rounded-t-[3px] sm:rounded-t-[6px]"
      style="left: 9.40%; top: 12.84%; width: 81.18%; height: 76.54%;"
    >
      <!-- Dark mode desktop screenshot -->
      <img
        src={desktopDark}
        srcset={getDesktopSrcset(desktopDark)}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1024px"
        alt={desktopAlt}
        width="1440"
        height="900"
        class="hidden dark:block w-full h-full object-cover object-top select-none pointer-events-none"
        loading="eager"
      />
      <!-- Light mode desktop screenshot -->
      <img
        src={desktopLight}
        srcset={getDesktopSrcset(desktopLight)}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1024px"
        alt={desktopAlt}
        width="1440"
        height="900"
        class="block dark:hidden w-full h-full object-cover object-top select-none pointer-events-none"
        loading="eager"
      />
    </div>

    <!-- MacBook Pro 16 Hardware Frame Overlay -->
    <img
      src="/frames/macbook-pro-16.webp"
      srcset="/frames/macbook-pro-16-640.webp 640w, /frames/macbook-pro-16-1024.webp 1024w, /frames/macbook-pro-16-1600.webp 1600w, /frames/macbook-pro-16-2400.webp 2400w, /frames/macbook-pro-16.webp 4256w"
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1024px"
      alt="MacBook Pro hardware frame"
      width="4256"
      height="2834"
      class="pointer-events-none relative z-10 w-full h-full select-none block"
      loading="eager"
      aria-hidden="true"
    />

    <!-- Overlaid Mobile Device (Pixel 9 Pro with Micro Notification Bar & Camera Notch) -->
    <div
      class="absolute -bottom-6 sm:-bottom-8 md:-bottom-12 -right-1 sm:right-2 md:right-6 lg:right-10 z-20 w-[30%] sm:w-[26%] md:w-[22%] max-w-[230px] aspect-[1620/3136] drop-shadow-[0_25px_35px_rgba(0,0,0,0.9)] filter transition-transform duration-300"
    >
      <!-- Mobile Inner Screen Container -->
      <div
        class="absolute overflow-hidden bg-[#0b0c0e] flex flex-col justify-between"
        style="left: 10.49%; top: 4.53%; width: 78.95%; height: 91.04%; border-radius: 8.5% / 4.2%;"
      >
        <!-- Sleek Micro Notification Bar Overlay -->
        <div class="absolute top-0 inset-x-0 z-20 h-2 sm:h-2.5 px-1.5 flex items-center justify-between text-neutral-600 dark:text-neutral-300 select-none bg-white/75 dark:bg-neutral-950/75 backdrop-blur-xs pointer-events-none">
          <!-- Time -->
          <div class="text-[5px] sm:text-[6px] font-semibold tracking-tight leading-none">
            9:41
          </div>

          <!-- Camera Notch / Punch Hole -->
          <div class="w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full bg-neutral-900 border border-neutral-700/60 flex items-center justify-center" aria-hidden="true">
            <span class="w-0.5 h-0.5 rounded-full bg-neutral-950"></span>
          </div>

          <!-- Status Icons -->
          <div class="flex items-center gap-0.5 opacity-80" aria-hidden="true">
            <!-- Cellular -->
            <svg class="w-1.5 h-1.5 fill-current" viewBox="0 0 16 16">
              <rect x="1" y="11" width="2" height="4" rx="0.5"></rect>
              <rect x="5" y="8" width="2" height="7" rx="0.5"></rect>
              <rect x="9" y="5" width="2" height="10" rx="0.5"></rect>
              <rect x="13" y="2" width="2" height="13" rx="0.5"></rect>
            </svg>
            <!-- Wi-Fi -->
            <svg class="w-1.5 h-1.5 fill-current" viewBox="0 0 16 16">
              <path d="M8 12.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm-4.24-2.83a6 6 0 0 1 8.48 0 .75.75 0 1 1-1.06 1.06 4.5 4.5 0 0 0-6.36 0 .75.75 0 1 1-1.06-1.06zm-2.83-2.83a10 10 0 0 1 14.14 0 .75.75 0 1 1-1.06 1.06 8.5 8.5 0 0 0-12.02 0 .75.75 0 0 1-1.06-1.06z"></path>
            </svg>
            <!-- Battery -->
            <div class="w-2 h-1 rounded-[1px] border border-current p-[0.5px] flex items-center">
              <div class="w-full h-full bg-current rounded-[0.5px]"></div>
            </div>
          </div>
        </div>

        <!-- Mobile App Screenshot: Dark & Light -->
        <div class="relative w-full h-full overflow-hidden bg-background">
          <img
            src={mobileDark}
            srcset={getMobileSrcset(mobileDark)}
            sizes="(max-width: 640px) 30vw, (max-width: 1024px) 25vw, 230px"
            alt={mobileAlt}
            width="750"
            height="1624"
            class="hidden dark:block w-full h-full object-cover object-top select-none pointer-events-none"
            loading="eager"
          />
          <img
            src={mobileLight}
            srcset={getMobileSrcset(mobileLight)}
            sizes="(max-width: 640px) 30vw, (max-width: 1024px) 25vw, 230px"
            alt={mobileAlt}
            width="750"
            height="1624"
            class="block dark:hidden w-full h-full object-cover object-top select-none pointer-events-none"
            loading="eager"
          />
        </div>

        <!-- Android Home Navigation Pill Indicator Overlay -->
        <div class="absolute bottom-0 inset-x-0 z-20 py-0.5 flex justify-center pointer-events-none" aria-hidden="true">
          <div class="w-6 sm:w-8 h-[1px] sm:h-0.5 rounded-full bg-neutral-400/60 dark:bg-neutral-500/60"></div>
        </div>
      </div>

      <!-- Pixel 9 Pro Hardware Frame Overlay -->
      <img
        src="/frames/pixel-9-pro.webp"
        srcset="/frames/pixel-9-pro-240.webp 240w, /frames/pixel-9-pro-480.webp 480w, /frames/pixel-9-pro.webp 1620w"
        sizes="(max-width: 640px) 30vw, (max-width: 1024px) 25vw, 230px"
        alt="Android Phone hardware frame"
        width="1620"
        height="3136"
        class="pointer-events-none relative z-30 w-full h-full select-none block"
        loading="eager"
        aria-hidden="true"
      />
    </div>
  </div>
</div>
